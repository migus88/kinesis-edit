<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:KinesisEdit.Controls">
  <!--
    The editor's own chrome: the read-only action fields of the spec 11 panels, the lighting mode
    menu and the colour swatches.

    Each style below is a *bridge*: it points one class at a ControlTheme in
    Themes/ControlThemes/, which owns the template and the whole state matrix. Nothing here names a
    template part any more — see Themes/ControlThemes/Shared.axaml for why that convention is gone.
  -->

  <!-- ===== Tabs ===============================================================================
       The section strip has no class of its own: it is a real TabStrip on the `TabStrip` theme
       (Themes/ControlThemes/Tabs.axaml), which carries the fixed 38 height, the accent underline
       drawn as its own template part, and the cleared `Transitions` the design's zero-length tab
       swap needs. The view names that theme directly.

       There is still deliberately nothing here that switches a page transition off. The strip
       selects and a Panel below it toggles IsVisible, so no container in the app owns a page
       transition in the first place; Avalonia 11's TabStrip and TabControl carry no PageTransition
       property either — Carousel is the only container that does, and the app uses none. -->

  <!-- The `⌥` of the layer segments' `⌥1`–`⌥5` legends (mockup 1f). It is an `Icon` and not the
       character, for the same reason the picker's `↵` below is one: U+2325 is in neither embedded
       IBM Plex family, so typing it would fall through to a platform substitute and to tofu where
       there is none.

       The class is not optional. `KbdChip` sets `Foreground` — and a second one under `:disabled` —
       but an `Icon` paints from `Stroke`/`Fill` and not from `TextElement.Foreground`, so neither
       of them reaches the mark. `TextSecondary` is the chip's own rest foreground, re-spelled here
       because that is the only way it arrives.

       `Size` 12 rather than the icon law's 16: the chip's type is 10 px mono inside 6,3 of padding,
       and a 16 px mark beside it would be the tallest thing in a 38 px tab bar. `Icon.assignHint`
       set that precedent at the same number; both are recorded in docs/app/design-system.md. -->
  <Style Selector="controls|Icon.kbdMark">
    <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="Size" Value="12" />
  </Style>

  <!-- ===== The key inspector rail ============================================================
       The Layout tab's third column (mockups 1e/2a): 268 wide on the inset surface, hairlined off
       the canvas beside it. Every number here is a token — the width is `WidthInspectorRail`,
       declared in Themes/Geometry.axaml since issue #86 and reached by nothing until now.

       The rail is NOT a modal surface and carries none of the overlay roles: the board stays
       clickable while it is open, which is the whole reason it replaces the feature panels it
       replaces. It is a column of the content grid, nothing more. -->
  <Style Selector="Border.inspectorRail">
    <Setter Property="Width" Value="{DynamicResource WidthInspectorRail}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceInsetBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SurfaceLineBrush}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
  </Style>

  <!-- One block of the rail, separated from the next by a hairline rather than by a gap: the rail
       is 268 wide and a stack of bordered cards inside it would spend a quarter of that on frames.
       `PaddingInspectorSection` is the design's own inspector rhythm. -->
  <Style Selector="Border.inspectorSection">
    <Setter Property="Padding" Value="{DynamicResource PaddingInspectorSection}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SurfaceLineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <!-- The footer is the same block with its hairline on top: it is pinned to the bottom of the
       rail, so the line belongs above it and not below the section it happens to follow. -->
  <Style Selector="Border.inspectorFooter">
    <Setter Property="Padding" Value="{DynamicResource PaddingInspectorSection}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SurfaceLineBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>

  <!-- The 32px tile at the head of the rail carrying the cap's own legend, so the inspector and
       the key it is talking about are visibly the same thing. Accent, because "selection" is one
       of the accent's two sanctioned meanings — this IS the selected key. -->
  <Style Selector="Border.inspectorKeyTile">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    <Setter Property="Background" Value="{DynamicResource AccentSelectionFillBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- ===== Action fields =====================================================================
       A read-only field showing what the next captured keystroke (or the Search Keys picker) put
       there. `TokenField` targets a Border and not a TextBox, and that is the point: focus in a
       TextBox auto-suspends capture, so a focusable token field would swallow the very keypress it
       exists to record. The theme declares `.armed` itself — the advisory border a listening key
       wears — so this bridge sets nothing but the theme, or it would outrank it. -->
  <Style Selector="Border.actionField">
    <Setter Property="Theme" Value="{StaticResource TokenField}" />
  </Style>

  <!-- ===== The token picker ==================================================================
       The Remap panel's search field, chips and result rows (mockups 1e/2a), and the same picker
       inside the macro-insertion modal. The catalog rows themselves wear the `SelectableListRow`
       control theme, named directly by the view; what is left here is the chrome around them.

       Nothing below carries a colour literal — every brush is a token — and nothing names a template
       part: the picker is authored out of a Border, a TextBox, a WrapPanel of Buttons and an Icon,
       each of which reaches its own ControlTheme through a class. -->

  <!-- The `●` of the Record button. It is an Ellipse and not the mockup's U+25CF, for the same
       reason mockup 1e's `⌕` became a Path: neither embedded IBM Plex family carries the codepoint,
       so the character would fall through to a platform substitute and tofu where there is none.
       StatusError, which handoff.md:82 names as "also the Record ● color". -->
  <Style Selector="Ellipse.recordDot">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="Fill" Value="{DynamicResource StatusErrorBrush}" />
  </Style>

  <!-- The `↵` of the selected row's `↵ assign` hint — drawn, not typed, for the same reason. It is
       TextSecondary rather than the accent: the row it sits in is already filled with the 14%
       accent selection tint, and AccentText is the colour that rides a SOLID accent fill (white on
       the light variant), which on a tint is invisible. -->
  <Style Selector="controls|Icon.assignHint">
    <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="Size" Value="12" />
  </Style>

  <!-- One block of the picker's result list: a counted header and its rows. The rows are inset from
       the header so the grouping reads without a rule between the blocks — the rail is 268 px wide
       and a stack of framed groups inside it would spend most of that on frames. -->
  <Style Selector="Border.tokenPickerGroup">
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <!-- The result list is bounded rather than free: a dialect's catalog runs to a couple of hundred
       rows, and an unbounded list would push the picker's own chips and counter out of the rail's
       scroll long before the user reached the end of it. The pre-redesign picker capped its list the
       same way, at the same order of height. -->
  <Style Selector="ScrollViewer.tokenPickerResults">
    <Setter Property="MaxHeight" Value="300" />
  </Style>

  <!-- The picker's inline advisory: amber, non-blocking, and the same tint block the rail states its
       mode-switch warning in, so "the app noticed something" reads the same wherever it is said. -->
  <Style Selector="Border.pickerAdvisory">
    <Setter Property="Background" Value="{DynamicResource StatusAdvisoryTintBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StatusAdvisoryTintBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    <Setter Property="Padding" Value="9,7" />
  </Style>

  <!-- ===== Lighting mode menu ================================================================
       One full-width row per mode, the selected one accent-filled. `ModeOption` carries the rail's
       own 9x7 rhythm and its `.selected` face. -->
  <Style Selector="Button.modeOption">
    <Setter Property="Theme" Value="{StaticResource ModeOption}" />
  </Style>

  <!-- The rail row's SECOND LINE: the parameters the mode accepts ("spd · L/R", "color · spd"),
       under its name. Mockup 2f writes every row as that pair, which is what makes the rail an
       answer to "what will change if I pick this one" rather than a list of names.

       It is a descendant style and not part of the ModeOption theme because a ControlTheme's nested
       styles are matched against the templated control and its TEMPLATE children only, never
       against content the view supplied — see the theme's own header. Nothing here names a template
       part; `Button.modeOption :is(TextBlock).modeSummary` is an ordinary descendant selector.

       MUTED RATHER THAN SMALLER, which is a deviation from the mock and is recorded in
       docs/app/design-system.md: the type scale has no sans step below 11 (10 is the mono section
       label), and inventing one for a rail row would put a new number in Themes/Typography.axaml to
       separate two lines that colour already separates. The name keeps the weight step the theme
       gives the row on selection; the summary stays at 400 either way, so the pair reads as a
       heading over a caption rather than as two headings. -->
  <Style Selector="Button.modeOption :is(TextBlock).modeSummary">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <!-- On the chosen row the fill is the full accent, and TextMuted on it is unreadable. AccentText
       is the colour that rides a solid accent face; the summary keeps its 400 against the name's
       500, which is what still tells the two lines apart there. -->
  <Style Selector="Button.modeOption.selected :is(TextBlock).modeSummary">
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>

  <!-- ===== The lighting parameter row ========================================================
       The direction arrows and the speed bars under the mode rail (mockup 2f: "Color `57C4D8`",
       "Speed 6 / 9", "Direction ← → ↑ ↓"). Both are bridges and nothing else — DirectionSegment
       carries the struck-through `.unavailable` state and SpeedBar the accent fill, each in
       Themes/ControlThemes/Segmented.axaml, and a setter here would outrank them. -->
  <Style Selector="Button.directionSegment">
    <Setter Property="Theme" Value="{StaticResource DirectionSegment}" />
  </Style>
  <Style Selector="Button.speedBar">
    <Setter Property="Theme" Value="{StaticResource SpeedBar}" />
  </Style>

  <!-- The arrow inside a direction segment, for the reason `Icon.modeMark` below exists: an Icon
       paints from a brush property and cannot inherit the button's Foreground, so the three roles
       the segment walks through are spelled out here. They are descendant selectors off the
       button's own classes rather than classes on the Icon, so a view writes the state once.

       `.unavailable` is declared LAST and therefore wins over `.selected`, which matches the
       theme's own `:not(.unavailable)` qualifier on the accent face: a struck arrow is never drawn
       as the chosen one. -->
  <Style Selector="Button.directionSegment controls|Icon">
    <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Button.directionSegment.selected controls|Icon">
    <Setter Property="Stroke" Value="{DynamicResource AccentTextBrush}" />
  </Style>
  <Style Selector="Button.directionSegment.unavailable controls|Icon">
    <Setter Property="Stroke" Value="{DynamicResource TextDisabledBrush}" />
  </Style>

  <!-- The mark beside a mode's caption. It cannot inherit the row's foreground the way the caption
       does - an Icon paints from a brush property, not from TextElement.Foreground - so the pair of
       roles the row switches between is spelled out here instead of at the call site.

       `.filled` is the same mark drawn as a solid: three of the sixteen modes are, and an Icon's
       fill and stroke are different properties, so the class picks which one the brush lands on.
       Setting both would turn every ring in the set into a disc. -->
  <Style Selector="controls|Icon.modeMark">
    <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="controls|Icon.modeMark.filled">
    <Setter Property="Stroke" Value="{x:Null}" />
    <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="controls|Icon.modeMark.selected">
    <Setter Property="Stroke" Value="{DynamicResource AccentTextBrush}" />
  </Style>
  <Style Selector="controls|Icon.modeMark.filled.selected">
    <Setter Property="Stroke" Value="{x:Null}" />
    <Setter Property="Fill" Value="{DynamicResource AccentTextBrush}" />
  </Style>

  <!-- ===== Colour swatches ===================================================================
       The premixed and custom squares of the picker, and the fill inside the effect/base colour
       buttons. The fill's outline is what keeps a white or a black square visible; its Background
       is device LED data, so it is the one place a colour legitimately arrives as a hex string
       from a config file rather than as a token. -->
  <Style Selector="Button.colorSwatch">
    <Setter Property="Padding" Value="2" />
    <Setter Property="Margin" Value="0,0,4,4" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Border.colorSwatchFill">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusChip}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource SurfaceLineHighBrush}" />
  </Style>

  <!-- Which of the effect / base colour buttons the picker is editing reads as an accent ring. It
       is a neutral bordered button until then, so it rides `SecondaryButton`; the ring is set on
       the Button itself, which the theme's own template binds through — the whole reason the
       presenter no longer has to be named. -->
  <Style Selector="Button.colorSlot">
    <Setter Property="Theme" Value="{StaticResource SecondaryButton}" />
  </Style>
  <Style Selector="Button.colorSlot.selected">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
</Styles>
