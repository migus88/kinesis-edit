<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:KinesisEdit.Controls">
  <!--
    The editor's own chrome: the read-only action fields of the spec 11 panels, the lighting mode
    menu and the colour swatches.

    Each style below is a *bridge*: it points one class at a ControlTheme in
    Themes/ControlThemes/, which owns the template and the whole state matrix. Nothing here names a
    template part any more — see Themes/ControlThemes/Shared.axaml for why that convention is gone.
  -->

  <!-- ===== Tabs ===============================================================================
       The section strip has no class of its own: it is a real TabStrip on the `TabStrip` theme
       (Themes/ControlThemes/Tabs.axaml), which carries the fixed 38 height, the accent underline
       drawn as its own template part, and the cleared `Transitions` the design's zero-length tab
       swap needs. The view names that theme directly.

       There is still deliberately nothing here that switches a page transition off. The strip
       selects and a Panel below it toggles IsVisible, so no container in the app owns a page
       transition in the first place; Avalonia 11's TabStrip and TabControl carry no PageTransition
       property either — Carousel is the only container that does, and the app uses none. -->

  <!-- ===== The key inspector rail ============================================================
       The Layout tab's third column (mockups 1e/2a): 268 wide on the inset surface, hairlined off
       the canvas beside it. Every number here is a token — the width is `WidthInspectorRail`,
       declared in Themes/Geometry.axaml since issue #86 and reached by nothing until now.

       The rail is NOT a modal surface and carries none of the overlay roles: the board stays
       clickable while it is open, which is the whole reason it replaces the feature panels it
       replaces. It is a column of the content grid, nothing more. -->
  <Style Selector="Border.inspectorRail">
    <Setter Property="Width" Value="{DynamicResource WidthInspectorRail}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceInsetBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SurfaceLineBrush}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
  </Style>

  <!-- One block of the rail, separated from the next by a hairline rather than by a gap: the rail
       is 268 wide and a stack of bordered cards inside it would spend a quarter of that on frames.
       `PaddingInspectorSection` is the design's own inspector rhythm. -->
  <Style Selector="Border.inspectorSection">
    <Setter Property="Padding" Value="{DynamicResource PaddingInspectorSection}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SurfaceLineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <!-- The footer is the same block with its hairline on top: it is pinned to the bottom of the
       rail, so the line belongs above it and not below the section it happens to follow. -->
  <Style Selector="Border.inspectorFooter">
    <Setter Property="Padding" Value="{DynamicResource PaddingInspectorSection}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SurfaceLineBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>

  <!-- The 32px tile at the head of the rail carrying the cap's own legend, so the inspector and
       the key it is talking about are visibly the same thing. Accent, because "selection" is one
       of the accent's two sanctioned meanings — this IS the selected key. -->
  <Style Selector="Border.inspectorKeyTile">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    <Setter Property="Background" Value="{DynamicResource AccentSelectionFillBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- ===== Action fields =====================================================================
       A read-only field showing what the next captured keystroke (or the Search Keys picker) put
       there. `TokenField` targets a Border and not a TextBox, and that is the point: focus in a
       TextBox auto-suspends capture, so a focusable token field would swallow the very keypress it
       exists to record. The theme declares `.armed` itself — the advisory border a listening key
       wears — so this bridge sets nothing but the theme, or it would outrank it. -->
  <Style Selector="Border.actionField">
    <Setter Property="Theme" Value="{StaticResource TokenField}" />
  </Style>

  <!-- ===== Lighting mode menu ================================================================
       One full-width row per mode, the selected one accent-filled. `ModeOption` carries the rail's
       own 9x7 rhythm and its `.selected` face. -->
  <Style Selector="Button.modeOption">
    <Setter Property="Theme" Value="{StaticResource ModeOption}" />
  </Style>

  <!-- The mark beside a mode's caption. It cannot inherit the row's foreground the way the caption
       does - an Icon paints from a brush property, not from TextElement.Foreground - so the pair of
       roles the row switches between is spelled out here instead of at the call site.

       `.filled` is the same mark drawn as a solid: three of the sixteen modes are, and an Icon's
       fill and stroke are different properties, so the class picks which one the brush lands on.
       Setting both would turn every ring in the set into a disc. -->
  <Style Selector="controls|Icon.modeMark">
    <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="controls|Icon.modeMark.filled">
    <Setter Property="Stroke" Value="{x:Null}" />
    <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="controls|Icon.modeMark.selected">
    <Setter Property="Stroke" Value="{DynamicResource AccentTextBrush}" />
  </Style>
  <Style Selector="controls|Icon.modeMark.filled.selected">
    <Setter Property="Stroke" Value="{x:Null}" />
    <Setter Property="Fill" Value="{DynamicResource AccentTextBrush}" />
  </Style>

  <!-- ===== Colour swatches ===================================================================
       The premixed and custom squares of the picker, and the fill inside the effect/base colour
       buttons. The fill's outline is what keeps a white or a black square visible; its Background
       is device LED data, so it is the one place a colour legitimately arrives as a hex string
       from a config file rather than as a token. -->
  <Style Selector="Button.colorSwatch">
    <Setter Property="Padding" Value="2" />
    <Setter Property="Margin" Value="0,0,4,4" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Border.colorSwatchFill">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusChip}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource SurfaceLineHighBrush}" />
  </Style>

  <!-- Which of the effect / base colour buttons the picker is editing reads as an accent ring. It
       is a neutral bordered button until then, so it rides `SecondaryButton`; the ring is set on
       the Button itself, which the theme's own template binds through — the whole reason the
       presenter no longer has to be named. -->
  <Style Selector="Button.colorSlot">
    <Setter Property="Theme" Value="{StaticResource SecondaryButton}" />
  </Style>
  <Style Selector="Button.colorSlot.selected">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
</Styles>
