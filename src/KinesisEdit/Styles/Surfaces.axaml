<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Surfaces: everything the app draws content *on*. Cards, the floating cards of the overlays and
    the toasts, the scrim that dims the editor under a modal, the framed lists, the hairline rows,
    and the status chip.

    Two design laws are enforced here rather than at the call sites:
      - Flat elevation is a 1px SurfaceLine border and no shadow at all. Only a surface that
        genuinely floats over another one casts a shadow, and then it casts the popover shadow or
        the modal shadow, never an invented one.
      - The motion budget is a budget. Every `Transitions` below binds a bare alias
        (`ModalTransitions`, ...) with `DynamicResource`; MotionResourceBinder points that alias at
        the full or the reduced set once at startup, so a view never chooses between them.

    Each animated surface is driven by an `.open` / `.shown` class rather than by `IsVisible`
    alone: `IsVisible` false collapses a control instantly and gives a transition nothing to run
    on, whereas a class flipping re-evaluates the Opacity setter and the transition plays.
  -->

  <!-- The window itself. `:is(Window)` rather than `Window`, because an Avalonia type selector
       matches the exact type and every window in the app is a subclass. -->
  <Style Selector=":is(Window)">
    <Setter Property="Background" Value="{DynamicResource SurfaceCanvasBrush}" />
  </Style>

  <!-- ===== Cards ============================================================================= -->

  <!-- The panel every group of content sits on. Radius 8, 1px line, 14 padding, no shadow. -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource SurfacePanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SurfaceLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusPanel}" />
    <Setter Property="Padding" Value="{DynamicResource PaddingCard}" />
  </Style>

  <!-- A dashboard card. Cards are keyed by drive identity and never reordered by a refresh; a
       newly detected device animates in at the end of the list, height only, 160 ms ease-out.
       The transition lives here so the dashboard has exactly one place that decides it. -->
  <Style Selector="Border.deviceCard">
    <Setter Property="Transitions" Value="{DynamicResource ListInsertTransitions}" />
  </Style>

  <!-- A card that floats: the toasts, the loading indicator, the feature panels. -->
  <Style Selector="Border.overlayCard">
    <Setter Property="Background" Value="{DynamicResource SurfacePanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SurfaceLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusPanel}" />
    <Setter Property="Padding" Value="{DynamicResource PaddingCard}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ShadowPopover}" />
  </Style>

  <!-- The same card when it is genuinely modal — a spec 11 panel over the scrim. It sits higher,
       so it casts the deeper shadow; everything else it inherits from `overlayCard`. -->
  <Style Selector="Border.overlayCard.modalCard">
    <Setter Property="BoxShadow" Value="{DynamicResource ShadowModal}" />
  </Style>

  <!-- ===== Modal and scrim ===================================================================
       The feature panels of specs/11-feature-dialogs.md render inline over the editor rather than
       as separate windows, so the scrim is what makes them read as modal: it dims the editor and,
       being hit-test visible, swallows every click aimed at it. -->
  <Style Selector="Border.overlayScrim">
    <Setter Property="Background" Value="{DynamicResource ScrimBrush}" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions" Value="{DynamicResource ScrimTransitions}" />
  </Style>
  <Style Selector="Border.overlayScrim.open">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- The host the open panel is rendered into. It fades separately from the scrim so the panel
       arrives on an already-dimmed editor rather than with it. -->
  <Style Selector="ContentControl.overlayHost">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions" Value="{DynamicResource ModalTransitions}" />
  </Style>
  <Style Selector="ContentControl.overlayHost.open">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- ===== Popovers ==========================================================================
       120 ms fade plus a 2 px rise. The rise is the RenderTransform half of `PopoverTransitions`,
       which the reduced set drops; the `.open` setter still lands on `none`, so with reduce-motion
       the surface simply appears in place. -->
  <Style Selector="ContentControl.popover">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="RenderTransform" Value="translateY(2px)" />
    <Setter Property="Transitions" Value="{DynamicResource PopoverTransitions}" />
  </Style>
  <Style Selector="ContentControl.popover.open">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="RenderTransform" Value="none" />
  </Style>

  <!-- The flyout surfaces Avalonia builds for us (the Special Actions menu, combo box drop-downs).
       They are popovers, so the budget governs them from here; Avalonia raises no open/closed
       pseudo-class on a presenter, so today this only bounds any property change the presenter
       makes of its own accord. -->
  <Style Selector="FlyoutPresenter">
    <Setter Property="Transitions" Value="{DynamicResource PopoverTransitions}" />
  </Style>
  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="Transitions" Value="{DynamicResource PopoverTransitions}" />
  </Style>

  <!-- ===== Toast =============================================================================
       In and out at 180 ms, with a 5 s dwell between them that NotificationOverlay owns — the
       toast has always carried its own timeout (specs/11-feature-dialogs.md §11.9), so there is
       one timer, not two. -->
  <Style Selector="Border.toast">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="RenderTransform" Value="translateY(6px)" />
    <Setter Property="Transitions" Value="{DynamicResource ToastTransitions}" />
  </Style>
  <Style Selector="Border.toast.shown">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="RenderTransform" Value="none" />
  </Style>

  <!-- ===== Status chip =======================================================================
       A pill whose fill states what the app found: connected, an advisory, a failure, or demo
       mode. The fill and its border cross-fade over 220 ms when the state changes; the text
       inside swaps instantly, which is what the design asks for. -->
  <Style Selector="Border.statusChip">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource SurfaceLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="Transitions" Value="{DynamicResource StatusFillTransitions}" />
  </Style>
  <Style Selector="Border.statusChip.ok">
    <Setter Property="Background" Value="{DynamicResource StatusOkTintBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StatusOkTintBorderBrush}" />
  </Style>
  <Style Selector="Border.statusChip.warning">
    <Setter Property="Background" Value="{DynamicResource StatusAdvisoryTintBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StatusAdvisoryTintBorderBrush}" />
  </Style>
  <Style Selector="Border.statusChip.error">
    <Setter Property="Background" Value="{DynamicResource StatusErrorTintBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StatusErrorTintBorderBrush}" />
  </Style>
  <Style Selector="Border.statusChip.demo">
    <Setter Property="Background" Value="{DynamicResource StatusDemoTintBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StatusDemoTintBorderBrush}" />
  </Style>

  <!-- ===== Framed lists and hairline rows ==================================================== -->

  <!-- A scrollable area that has to read as one field: the recorded macro steps, the profile's
       macro list. -->
  <Style Selector="Border.listFrame">
    <Setter Property="BorderBrush" Value="{DynamicResource SurfaceLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    <Setter Property="Padding" Value="4" />
  </Style>

  <!-- One row of a settings panel or of the pedal table. A separator belongs *between* rows, so it
       is a top border on every row but the first: a bottom border would leave a trailing hairline
       under the last row, and a top border on all of them draws one flush inside the card's own
       top edge, above the first row, with nothing above it to separate.

       Every listRow in the app is the root of an ItemsControl's ItemTemplate, so the row sits in a
       generated ContentPresenter and it is that presenter, not the Border, that is a sibling of
       the other rows in the items panel — which is what :nth-child can count. -->
  <Style Selector="Border.listRow">
    <Setter Property="BorderBrush" Value="{DynamicResource SurfaceLineBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="0,12" />
  </Style>
  <Style Selector="ContentPresenter:nth-child(1) > Border.listRow">
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- ===== Pedal entry ======================================================================= -->

  <!-- The panel of specs/12-savant-elite.md §5 that opens under the input being programmed. -->
  <Style Selector="Border.entryPanel">
    <Setter Property="Background" Value="{DynamicResource SurfaceBarBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SurfaceLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusPanel}" />
    <Setter Property="Padding" Value="{DynamicResource PaddingCard}" />
    <Setter Property="Margin" Value="0,8,0,4" />
  </Style>

  <!-- The entry box itself: a read-only, selectable display of what has been recorded so far.
       Deliberately not a TextBox — focus in one auto-suspends the capture service, so typing into
       the pedal would record nothing. It is armed while it is open, hence the advisory border. -->
  <Style Selector="Border.entryBox">
    <Setter Property="Background" Value="{DynamicResource SurfaceInsetBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StatusAdvisoryBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="MinHeight" Value="44" />
  </Style>
</Styles>
