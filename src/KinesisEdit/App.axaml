<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:KinesisEdit.Converters"
             xmlns:local="clr-namespace:KinesisEdit"
             x:Class="KinesisEdit.App"
             RequestedThemeVariant="Default">
  <!--
    Composition only. This file wires the view locator, the converters, the theme and the design
    system together and defines nothing itself: no colour, no style, no size. Tokens live in
    Themes/, the styles built on them in Styles/, and a view that needs either names it.

    "Default" follows the OS theme variant; "Dark" or "Light" pin it.
  -->

  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <converters:EnumMatchConverter x:Key="EnumMatch" />
      <converters:MessageBoxIconToGlyphConverter x:Key="MessageBoxIconGlyph" />
      <converters:HexColorToBrushConverter x:Key="HexColorToBrush" />
      <converters:MenuItemToggleTypeConverter x:Key="MenuItemToggle" />
      <converters:HexColorToColorConverter x:Key="HexColorToColor" />

      <!-- The design system (docs/design/). Tokens carries the colour roles in Dark and Light
           theme dictionaries; Geometry the radii, paddings and the spacing scale; Motion the
           budget. Typography is a Styles rather than a ResourceDictionary — a resource dictionary
           cannot hold Style elements — so it is included under Application.Styles below instead of
           merged here.

           Controls comes last because it is an alias map over the other two: it redeclares the
           FluentTheme's own control keys (ButtonBackground, ComboBoxBorderBrush, ...) against
           those roles, so the base controls paint from the design system instead of from Fluent's
           palette. It has to live here, in Application.Resources, rather than in Styles/ — that is
           the scope Avalonia consults before Application.Styles, which is where FluentTheme's
           originals are. -->
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://KinesisEdit/Themes/Tokens.axaml" />
        <ResourceInclude Source="avares://KinesisEdit/Themes/Geometry.axaml" />
        <ResourceInclude Source="avares://KinesisEdit/Themes/Motion.axaml" />
        <ResourceInclude Source="avares://KinesisEdit/Themes/Controls.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- The ColorView the lighting picker wraps ships its control theme in its own assembly, so
         FluentTheme above does not carry it; without this include the picker renders untemplated. -->
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />

    <!-- The type half of the design system: the two IBM Plex families and the type scale, as named
         TextBlock classes plus raw sizes. It also puts Plex Sans on the window, so the whole tree
         inherits it. -->
    <StyleInclude Source="avares://KinesisEdit/Themes/Typography.axaml" />

    <!-- The shared style layer, split by concern. Order matters only between Typography and these:
         a role style may override a scale step, never the other way round. -->
    <StyleInclude Source="avares://KinesisEdit/Styles/Text.axaml" />
    <StyleInclude Source="avares://KinesisEdit/Styles/Surfaces.axaml" />
    <StyleInclude Source="avares://KinesisEdit/Styles/Buttons.axaml" />
    <StyleInclude Source="avares://KinesisEdit/Styles/Keyboard.axaml" />
    <StyleInclude Source="avares://KinesisEdit/Styles/Editor.axaml" />
  </Application.Styles>
</Application>
