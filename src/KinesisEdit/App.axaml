<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:KinesisEdit.Converters"
             xmlns:local="clr-namespace:KinesisEdit"
             x:Class="KinesisEdit.App"
             RequestedThemeVariant="Default">
  <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <converters:EnumMatchConverter x:Key="EnumMatch" />
      <converters:MessageBoxIconToGlyphConverter x:Key="MessageBoxIconGlyph" />
      <converters:HexColorToBrushConverter x:Key="HexColorToBrush" />

      <!-- Kinesis blue, the brand accent of specs/10-apps-and-ui.md "Fonts, colors, theming". -->
      <Color x:Key="KinesisBlueColor">#0072CE</Color>

      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="StatusOkBrush" Color="#15803D" />
          <SolidColorBrush x:Key="StatusWarningBrush" Color="#B45309" />
          <SolidColorBrush x:Key="StatusErrorBrush" Color="#C0261F" />
          <SolidColorBrush x:Key="AccentTextBrush" Color="#0060AD" />
          <SolidColorBrush x:Key="ShellBarBrush" Color="#F2F3F5" />
          <SolidColorBrush x:Key="ShellBarBorderBrush" Color="#D8DADD" />
          <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="CardBorderBrush" Color="#D8DADD" />
          <SolidColorBrush x:Key="OverlayBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="MutedTextBrush" Color="#5A6169" />

          <!-- Keyboard picture (issue #14): the board it sits on, the cap, and the four cap
               states. Every one of them exists in both variants, because the editor is the
               densest surface in the app and a single hard-coded color would be unreadable in
               one of the two themes. -->
          <SolidColorBrush x:Key="KeyboardBoardBrush" Color="#ECEEF1" />
          <SolidColorBrush x:Key="KeyboardBoardBorderBrush" Color="#D8DADD" />
          <SolidColorBrush x:Key="KeyCapBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="KeyCapBorderBrush" Color="#C3C8CE" />
          <SolidColorBrush x:Key="KeyCapTextBrush" Color="#1F2328" />
          <SolidColorBrush x:Key="KeyCapHoverBrush" Color="#E4EFFA" />
          <SolidColorBrush x:Key="KeyCapModifiedBrush" Color="#D8E9FB" />
          <SolidColorBrush x:Key="KeyCapModifiedBorderBrush" Color="#8CB8E4" />
          <SolidColorBrush x:Key="KeyCapLockedBrush" Color="#E3E5E8" />
          <SolidColorBrush x:Key="KeyCapLockedBorderBrush" Color="#D2D5D9" />
          <SolidColorBrush x:Key="KeyCapSelectedBorderBrush" Color="#0072CE" />
          <SolidColorBrush x:Key="KeyCapListeningBrush" Color="#FDEFCB" />
          <SolidColorBrush x:Key="KeyCapListeningBorderBrush" Color="#B45309" />
          <SolidColorBrush x:Key="EditorTabSelectedBrush" Color="#0072CE" />
          <SolidColorBrush x:Key="EditorTabSelectedBorderBrush" Color="#0060AD" />
          <SolidColorBrush x:Key="EditorTabSelectedTextBrush" Color="#FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="StatusOkBrush" Color="#5CD37F" />
          <SolidColorBrush x:Key="StatusWarningBrush" Color="#E0A030" />
          <SolidColorBrush x:Key="StatusErrorBrush" Color="#F1706A" />
          <SolidColorBrush x:Key="AccentTextBrush" Color="#4FA9EC" />
          <SolidColorBrush x:Key="ShellBarBrush" Color="#22242A" />
          <SolidColorBrush x:Key="ShellBarBorderBrush" Color="#3A3D45" />
          <SolidColorBrush x:Key="CardBrush" Color="#2A2D34" />
          <SolidColorBrush x:Key="CardBorderBrush" Color="#3A3D45" />
          <SolidColorBrush x:Key="OverlayBrush" Color="#2A2D34" />
          <SolidColorBrush x:Key="MutedTextBrush" Color="#A6ADB6" />

          <SolidColorBrush x:Key="KeyboardBoardBrush" Color="#1D1F24" />
          <SolidColorBrush x:Key="KeyboardBoardBorderBrush" Color="#3A3D45" />
          <SolidColorBrush x:Key="KeyCapBrush" Color="#343841" />
          <SolidColorBrush x:Key="KeyCapBorderBrush" Color="#494E58" />
          <SolidColorBrush x:Key="KeyCapTextBrush" Color="#E7EAEE" />
          <SolidColorBrush x:Key="KeyCapHoverBrush" Color="#414855" />
          <SolidColorBrush x:Key="KeyCapModifiedBrush" Color="#1F3D59" />
          <SolidColorBrush x:Key="KeyCapModifiedBorderBrush" Color="#3D74A8" />
          <SolidColorBrush x:Key="KeyCapLockedBrush" Color="#292C32" />
          <SolidColorBrush x:Key="KeyCapLockedBorderBrush" Color="#383C43" />
          <SolidColorBrush x:Key="KeyCapSelectedBorderBrush" Color="#4FA9EC" />
          <SolidColorBrush x:Key="KeyCapListeningBrush" Color="#4A3A17" />
          <SolidColorBrush x:Key="KeyCapListeningBorderBrush" Color="#E0A030" />
          <SolidColorBrush x:Key="EditorTabSelectedBrush" Color="#1D5B92" />
          <SolidColorBrush x:Key="EditorTabSelectedBorderBrush" Color="#4FA9EC" />
          <SolidColorBrush x:Key="EditorTabSelectedTextBrush" Color="#FFFFFF" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- Status colors: 'Connected' / 'v-Drive OK' green, failures red, demo mode amber
         (specs/10-apps-and-ui.md, "Detection loop"). Both palettes are theme-scoped, so the
         same class reads correctly in the OS light and dark variants. -->
    <Style Selector="TextBlock.statusOk">
      <Setter Property="Foreground" Value="{DynamicResource StatusOkBrush}" />
    </Style>
    <Style Selector="TextBlock.statusWarning">
      <Setter Property="Foreground" Value="{DynamicResource StatusWarningBrush}" />
    </Style>
    <Style Selector="TextBlock.statusError">
      <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}" />
    </Style>

    <Style Selector="TextBlock.messageIconAccent">
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="TextBlock.messageIconWarning">
      <Setter Property="Foreground" Value="{DynamicResource StatusWarningBrush}" />
    </Style>
    <Style Selector="TextBlock.messageIconError">
      <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}" />
    </Style>

    <Style Selector="TextBlock.heading">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>
    <Style Selector="TextBlock.messageIcon">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="MinWidth" Value="28" />
      <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="Border.overlayCard">
      <Setter Property="Background" Value="{DynamicResource OverlayBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="BoxShadow" Value="0 4 16 0 #33000000" />
    </Style>

    <!-- ===== Keyboard editor (issue #14) =====================================================
         The one button of a surface that commits something (the editor's Save). -->
    <Style Selector="Button.primaryAction">
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- The board the keyboard picture is drawn on. -->
    <Style Selector="Border.keyboardBoard">
      <Setter Property="Background" Value="{DynamicResource KeyboardBoardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource KeyboardBoardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12" />
    </Style>

    <!-- One key cap. Its chrome is set on the Button's template presenter rather than on the
         Button, because the Fluent theme's own :pointerover / :pressed / :disabled setters target
         that presenter and would otherwise win over a Background set here. The cap states are
         declared in increasing precedence — later styles override earlier ones — so a listening
         key always reads as listening, whatever else it also is. -->
    <Style Selector="Button.keyCap">
      <Setter Property="Padding" Value="2" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.keyCap /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource KeyCapBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource KeyCapBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Button.keyCap.modified /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource KeyCapModifiedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource KeyCapModifiedBorderBrush}" />
    </Style>
    <Style Selector="Button.keyCap.locked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource KeyCapLockedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource KeyCapLockedBorderBrush}" />
    </Style>
    <Style Selector="Button.keyCap:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource KeyCapHoverBrush}" />
    </Style>
    <Style Selector="Button.keyCap.selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource KeyCapSelectedBorderBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.keyCap.listening /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource KeyCapListeningBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource KeyCapListeningBorderBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="TextBlock.keyCapText">
      <Setter Property="Foreground" Value="{DynamicResource KeyCapTextBrush}" />
    </Style>
    <Style Selector="TextBlock.keyCapText.modified">
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.keyCapText.locked">
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>

    <!-- Layer switcher: one pill per layer, scaling from the two of a Freestyle Edge RGB to the
         five of an Advantage 360 without any change here. -->
    <Style Selector="Button.layerTab">
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="MinWidth" Value="64" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.layerTab /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="14" />
    </Style>
    <Style Selector="Button.layerTab.selected">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.layerTab.selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource EditorTabSelectedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EditorTabSelectedBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource EditorTabSelectedTextBrush}" />
    </Style>

    <!-- Editor tab strip. Only the selected tab is underlined; a tab with nothing behind it stays
         visibly disabled, which is why the Fluent :disabled foreground is left alone. -->
    <Style Selector="Button.editorTab">
      <Setter Property="Padding" Value="16,7" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.editorTab /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.editorTab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource KeyCapHoverBrush}" />
    </Style>
    <Style Selector="Button.editorTab.selected">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.editorTab.selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource EditorTabSelectedBrush}" />
    </Style>
  </Application.Styles>
</Application>
