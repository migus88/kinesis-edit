      <!-- ===== System roles ====================================================================
           The keys Fluent reaches for from more than one control theme. `SystemAccentColor` is the
           blue every control theme derives from, so pointing it at our accent catches anything
           this file does not enumerate; the list highlights are what a ListBoxItem, a MenuItem and
           a TreeViewItem paint their hover and selection with, and Fluent exposes no per-control
           key for them. -->
      <StaticResource x:Key="SystemAccentColor" ResourceKey="AccentColor" />
      <StaticResource x:Key="SystemControlFocusVisualPrimaryBrush" ResourceKey="AccentBrush" />
      <StaticResource x:Key="SystemControlFocusVisualSecondaryBrush" ResourceKey="AccentBrush" />
      <StaticResource x:Key="SystemControlHighlightListLowBrush" ResourceKey="SurfaceRaisedBrush" />
      <StaticResource x:Key="SystemControlHighlightListLowRevealBackgroundBrush" ResourceKey="SurfaceRaisedBrush" />
      <StaticResource x:Key="SystemControlHighlightListMediumBrush" ResourceKey="SurfaceLineBrush" />
      <StaticResource x:Key="SystemControlHighlightListMediumRevealBackgroundBrush" ResourceKey="SurfaceLineBrush" />
      <StaticResource x:Key="SystemControlHighlightListAccentLowBrush" ResourceKey="AccentSelectionFillBrush" />
      <StaticResource x:Key="SystemControlHighlightListAccentMediumBrush" ResourceKey="AccentSelectionFillBrush" />
      <StaticResource x:Key="SystemControlHighlightListAccentHighBrush" ResourceKey="AccentSelectionFillBrush" />
    </ResourceDictionary>

    <!-- ================================================================================
         LIGHT. Identical key set; the accent ramp is the only thing that differs, and it
         differs because the colour riding the accent flips to white here.
         ================================================================================ -->
    <ResourceDictionary x:Key="Light">

      <!-- ===== Button, RepeatButton ============================================================ -->
      <StaticResource x:Key="ButtonBackground" ResourceKey="SurfaceBarBrush" />
      <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SurfaceRaisedBrush" />
