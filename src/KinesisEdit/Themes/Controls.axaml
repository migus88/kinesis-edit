      <StaticResource x:Key="RepeatButtonBorderBrushPressed" ResourceKey="SurfaceLineHighBrush" />
      <StaticResource x:Key="RepeatButtonBorderBrushDisabled" ResourceKey="SurfaceLineBrush" />

      <!-- ===== Accent button ===================================================================
           White rides the accent here, so the fill deepens on hover (AccentSelectedRing) and lifts
           back to the base accent under the press — the reverse of dark, and the reason this block
           is not shared. -->
      <StaticResource x:Key="AccentButtonBackground" ResourceKey="AccentBrush" />
      <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="AccentSelectedRingBrush" />
      <StaticResource x:Key="AccentButtonBackgroundPressed" ResourceKey="AccentBrush" />
