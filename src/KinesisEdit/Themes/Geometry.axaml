<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    The shape half of the design system (docs/design/handoff.md §"Geometry").

    Everything sits on a 4px grid. These are theme-independent: a corner radius does not change
    when the OS flips to light, so they live outside `ThemeDictionaries` and resolve in either
    variant.
  -->

  <!-- Radii. Four steps plus the pill. Panels and cards are the roundest thing in the app;
       keycaps and the little kbd chips are tighter, so a dense board does not read as blobby. -->
  <CornerRadius x:Key="RadiusPanel">8</CornerRadius>
  <CornerRadius x:Key="RadiusControl">5</CornerRadius>
  <CornerRadius x:Key="RadiusKeycap">4</CornerRadius>
  <CornerRadius x:Key="RadiusChip">3</CornerRadius>
  <CornerRadius x:Key="RadiusPill">999</CornerRadius>

  <!-- Padding rhythms. Avalonia's two-value Thickness is "horizontal,vertical", which is the
       reverse of the CSS shorthand the handoff is written in: its "8,13" button padding is
       13 horizontal by 8 vertical, hence "13,8" here. -->
  <Thickness x:Key="PaddingCard">14</Thickness>
  <Thickness x:Key="PaddingInspectorSection">12</Thickness>
  <Thickness x:Key="PaddingButton">13,8</Thickness>
  <Thickness x:Key="PaddingTab">13,0</Thickness>

  <!-- The spacing scale. Nothing in a view should use a gap that is not one of these six. -->
  <x:Double x:Key="Space4">4</x:Double>
  <x:Double x:Key="Space8">8</x:Double>
  <x:Double x:Key="Space12">12</x:Double>
  <x:Double x:Key="Space16">16</x:Double>
  <x:Double x:Key="Space24">24</x:Double>
  <x:Double x:Key="Space32">32</x:Double>

  <!-- Chrome. Fixed heights, because the toolbar and the tab strip must not grow with their
       content — a device with a long name may not push the board down. -->
  <x:Double x:Key="HeightToolbar">46</x:Double>
  <x:Double x:Key="HeightTabBar">38</x:Double>
  <x:Double x:Key="HeightAdvisoryStrip">30</x:Double>

  <!-- Rails and gutters. The inspector widens only on the macro-editing variant, where the
       recorded step list needs the room. -->
  <x:Double x:Key="WidthInspectorRail">268</x:Double>
  <x:Double x:Key="WidthInspectorRailWide">300</x:Double>
  <x:Double x:Key="GutterSplit">26</x:Double>

  <!-- The dashboard card grid: two columns, and a 2px status rail flush against the left edge
       of every card.

       The gap reaches the grid as the two Thicknesses beside it, because Avalonia's UniformGrid
       has no spacing property and a Margin is a Thickness that no markup can compose out of an
       x:Double. Each cell carries the gap on its right and bottom; the panel carries the negative
       of it, which inflates its slot by exactly one gap in each direction so the last column ends
       on the viewport's edge and the scroll extent stops at the bottom of the last row. The three
       are one number and are pinned to each other by ShapeAndTypeTokenTests - change the gap and
       the siblings have to follow, or the suite says so. -->
  <x:Double x:Key="CardGridGap">12</x:Double>
  <Thickness x:Key="CardGridCellGap">0,0,12,12</Thickness>
  <Thickness x:Key="CardGridPanelBleed">0,0,-12,-12</Thickness>
  <x:Double x:Key="WidthCardStatusRail">2</x:Double>

  <!-- Every dashboard card is exactly this tall, whichever state it is in: "the card keeps its
       size and its buttons keep their positions - only the status line and a 3px indeterminate
       bar change, so a 2s refresh can't shift the layout under the cursor" (mockup 2e).

       Derived from the mockup canvas' own box model for the tallest state, the unwritable card
       with its two-line explanation: 2 border + 28 padding + 70 art frame (56 + 6 padding + 1
       border, doubled) + 12 + 51.9 explanation (2 x 15.95 + 18 padding + 2 border) + 12 + 30
       buttons = 205.9. Avalonia's line boxes are the font's own metrics rather than the mock's
       explicit line-heights, which puts the same anatomy at ~211 here (16.5 prose leading, a
       33.6 button). 212 is the next step of the 4px grid that clears both. -->
  <x:Double x:Key="HeightDeviceCard">212</x:Double>

  <!-- Icons are geometry, never raster: a 16px box drawn with a 1.5px square-capped stroke. -->
  <x:Double x:Key="IconSize">16</x:Double>
  <x:Double x:Key="IconStrokeThickness">1.5</x:Double>

  <!-- A dialog's type mark is drawn larger than a rail icon: the handoff's message box carries a
       24px mark, because it is the one thing that says what kind of interruption this is. -->
  <x:Double x:Key="IconSizeDialog">24</x:Double>

  <!-- The busy spinner: a 14px circle with one quadrant left transparent. -->
  <x:Double x:Key="SpinnerSize">14</x:Double>
  <x:Double x:Key="SpinnerStrokeThickness">1.5</x:Double>

  <!-- Hatching, for a locked key and for an LED that is off: 45 degrees at a 4px pitch. -->
  <x:Double x:Key="HatchPitch">4</x:Double>
  <x:Double x:Key="HatchAngle">45</x:Double>
</ResourceDictionary>
