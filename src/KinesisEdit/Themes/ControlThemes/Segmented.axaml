<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    The segmented family. Read Shared.axaml's header first — it carries the authoring contract, and
    BaseButton carries the template, the geometry, the type step, the focus ring and the disabled
    face that ToggleSegment at the bottom of this file derives from.

    Six themes, one shape language: a row of adjoining choices where exactly one — or, for the
    toggle, each one independently — is on.

      SegmentedControl / SegmentedItem  the layer switcher: a trough with the segments inside it,
                                        one selected.
      ToggleSegment                     a standalone two-state segment: the pedal's Single Action /
                                        Macro latch and the lighting tab's zone chips.
      ComposerSegment                   ToggleSegment at SegmentedItem's own 11,4 / 11px: the macro
                                        composer's tap/press/release and fixed/random, which share
                                        one line of the compose bar.
      DirectionSegment                  one arrow of the lighting tab's direction row, which a mode
                                        may not accept — and which is then STRUCK THROUGH in place
                                        rather than removed.
      SpeedBar                          one bar of the lighting tab's speed control, "segmented
                                        bars (accent-filled)" (docs/design/handoff.md:150).

    WHY A ListBox AND NOT A RadioButton GROUP. docs/design/handoff.md offers both ("Segmented
    controls (layer switcher, speed bars): restyled ListBox with horizontal StackPanel, or
    RadioButton group styled as segments"). Every call site is already an ItemsControl over a
    collection of view models, so the ListBox keeps the view a data binding — items, a selection,
    and no per-item plumbing — where a RadioButton group would need a group name and an
    IsChecked converter per item, and would lose the one-Tab-stop-per-group keyboard behaviour a
    SelectingItemsControl gives for free.

    DEVIATION FROM docs/design/. The mockups draw the layer switcher's SELECTED segment as a raised
    neutral face (dark `#23272C` on the `#131619` trough with a `#3A4046` border; light `#FFFFFF` on
    `#EEF0F1` with `#C9CFD2`), not as an accent fill. This theme fills it with the accent instead,
    on issue #86's instruction and to keep the app's one accent law legible — "one accent, two
    meanings: selection/focus, and you changed this" — and because the same handoff calls the other
    consumer of this control, the lighting speed bars, "accent-filled" verbatim. The mock's geometry
    is followed exactly (2px trough padding and gap, RadiusControl trough around RadiusChip
    segments, 11px type stepping 400 -> 500 on selection); only the selected face's three colours
    differ. Flipping back is those three setters under `^:selected`.
  -->

  <!--
    ONE SEGMENT. Transparent until it is chosen, so the trough behind it is what separates the
    choices and nothing draws a box the design does not ask for.

    Set as SegmentedControl's ItemContainerTheme below, which is why no view ever names this key:
    a consumer themes the ListBox and the containers follow.
  -->
  <ControlTheme x:Key="SegmentedItem" TargetType="ListBoxItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusChip}" />

    <!-- The mock's `padding: 4px 11px`, i.e. 11 horizontal by 4 vertical. Not one of the six
         spacing steps, because this is a control's internal rhythm rather than a gap between
         controls — the same reason PaddingButton is 13x8. -->
    <Setter Property="Padding" Value="11,4" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />

    <!-- Contract 3: our ring replaces Fluent's dotted adorner rather than doubling up with it. -->
    <Setter Property="FocusAdorner" Value="{x:Null}" />

    <!-- Contract 6: the halo is a BoxShadow with spread, drawn outside Root's own bounds. -->
    <Setter Property="ClipToBounds" Value="False" />

    <!-- Contract 8, and the budget's one deliberate zero: "layer switching is deliberately
         unanimated ... 200 ms x 200 switches is the difference between an instrument and a
         website". Cleared outright rather than set to a zero duration, because a zero-duration
         transition still costs a frame of bookkeeping per switch. -->
    <Setter Property="Transitions" Value="{x:Null}" />

    <Setter Property="Template">
      <ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Root"
                ClipToBounds="False"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter x:Name="Label"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- Contract 5, twice over. Selection outranks hover: a chosen segment the pointer happens to
         be over is still the chosen segment. And Avalonia raises `:pointerover` AND `:pressed`
         while the pointer is down, so the hover FILL hands the face to the press style below by
         saying `:not(:pressed)` rather than by sitting above it in the file.

         The hover BORDER carries no such qualifier, deliberately: the press declares no border of
         its own, so the hairline hover acquired is what a pressed segment goes on wearing, and the
         two setters never disagree. -->
    <Style Selector="^:pointerover:not(:pressed):not(:selected)">
      <Setter Property="Background" Value="{DynamicResource SurfaceKeySelectedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="^:pointerover:not(:selected):not(:focus-visible)">
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceLineBrush}" />
    </Style>

    <Style Selector="^:pressed:not(:selected)">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- The chosen segment: the accent fill, the on-accent label, and the one weight step the
         mockups draw on it (400 -> 500). See the deviation note in the header for the fill. -->
    <Style Selector="^:selected">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!-- Contract 4. Selection's own ring is the deeper accent, so a selected segment reads as
         selected with no focus anywhere; when focus does arrive it takes the border to the full
         accent and adds the halo outside it, and the two stay told apart. -->
    <Style Selector="^:selected:not(:focus-visible)">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentSelectedRingBrush}" />
    </Style>

    <!-- A segment the firmware gates off — the lighting Fn layer below LED 1.0.44 — is shown and
         dimmed rather than hidden, because the layer exists and the reason is printed beside it.
         It keeps no face at all: a filled disabled segment would carry more presence inside the
         trough than the enabled ones beside it. Declared last of the faces on purpose, so it
         outranks selection too — a gated segment must not read as the chosen one. -->
    <Style Selector="^:disabled">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
    </Style>

    <!-- Contract 3, verbatim. Focus outranks every pointer state, which is why those carry
         `:not(:focus-visible)` above. -->
    <Style Selector="^:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#Root">
      <Setter Property="BoxShadow" Value="{DynamicResource ShadowFocusHalo}" />
    </Style>
  </ControlTheme>

  <!--
    THE TROUGH. An inset surface with a 1px line around it and the segments sitting 2px inside, so
    the group reads as one control with an interior rather than as a row of loose buttons
    (docs/design/mockups.md 1e/2a: `padding: 2px; border-radius: 5px; gap: 2px`). The 2px inset is
    also what makes the radii concentric — RadiusControl 5 outside, RadiusChip 3 inside.

    ClipToBounds stays false here as well as on the segment (contract 6): the first and last
    segments' focus haloes are painted 3px outside the trough, and a clip on the container would
    erase exactly the halves of the ring that leave it.
  -->
  <ControlTheme x:Key="SegmentedControl" TargetType="ListBox">
    <Setter Property="Background" Value="{DynamicResource SurfaceInsetBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SurfaceLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    <Setter Property="Padding" Value="2" />

    <!-- A segmented control is intrinsically as wide as its choices; a stretched trough would run
         the width of whatever column it is dropped into. -->
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Transitions" Value="{x:Null}" />

    <!-- There is always a layer, always a speed. Clicking the chosen segment again must not empty
         the control. -->
    <Setter Property="SelectionMode" Value="AlwaysSelected" />

    <!-- So a consumer names only the outer key and the containers follow. -->
    <Setter Property="ItemContainerTheme" Value="{StaticResource SegmentedItem}" />

    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" Spacing="2" ClipToBounds="False" />
      </ItemsPanelTemplate>
    </Setter>

    <!-- No ScrollViewer, unlike Fluent's ListBox: a segmented control that scrolls is a segmented
         control with too many segments, and a ScrollViewer would clip the haloes the contract
         insists on keeping. -->
    <Setter Property="Template">
      <ControlTemplate TargetType="ListBox">
        <Border x:Name="Root"
                ClipToBounds="False"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ItemsPresenter x:Name="Items" ItemsPanel="{TemplateBinding ItemsPanel}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!--
    A STANDALONE TWO-STATE SEGMENT — the macro co-triggers (each independently on or off) and the
    pedal editor's Single Action / Macro latch. It is not in a trough and it is not part of a
    selection: each one is its own on/off, which is why it is a Button driven by `.selected` rather
    than a ListBoxItem driven by `:selected`.

    Off is the neutral bordered face of SecondaryButton — a toggle has to look like a control before
    it is switched on — and on is the accent fill, the same "this is chosen" the segment above uses.
  -->
  <ControlTheme x:Key="ToggleSegment" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="Background" Value="{DynamicResource SurfaceBarBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderRaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="Transitions" Value="{x:Null}" />

    <Style Selector="^:pointerover:not(:pressed):not(.selected)">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="^:pointerover:not(:pressed):not(.selected):not(:focus-visible)">
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceLineHighBrush}" />
    </Style>

    <Style Selector="^:pressed:not(.selected)">
      <Setter Property="Background" Value="{DynamicResource SurfaceLineBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="^:pressed:not(.selected):not(:focus-visible)">
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceLineHighBrush}" />
    </Style>

    <!-- On. Declared after the pointer states and qualified into them, so pressing a toggle that is
         already on does not flicker it back to the neutral face on the way to switching it off.

         `:not(:disabled)` is the qualifier Pills.axaml's header calls easy to miss, and this theme
         needs it for the same reason NavPill does: Avalonia walks BasedOn first, so BaseButton's
         `:disabled` face is applied BEFORE anything declared here and an unqualified `.selected`
         would win over it. A co-trigger the firmware has gated off, or the pedal's latch on a
         board in demo mode, would keep the full accent fill and the on-accent label and carry no
         disabled signal at all. -->
    <Style Selector="^.selected:not(:disabled)">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="^.selected:not(:disabled):not(:focus-visible)">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentSelectedRingBrush}" />
    </Style>

    <!-- Disabled and the focus ring both come from BaseButton: the inset face is right here, where
         the toggle has a face of its own to lose. -->
  </ControlTheme>

  <!--
    THE MACRO COMPOSER'S SEGMENTS (issue #148) — `tap` / `press` / `release` and `fixed` / `random`,
    the two strips that share one line of the compose bar with `then wait`, a millisecond field and
    `ms`.

    IT IS ToggleSegment WITH THE FAMILY'S OWN RHYTHM PUT BACK, and nothing else. ToggleSegment is
    BaseButton, so it wears the app's `PaddingButton` 13,8 at the control type step (12px) — right
    for a standalone latch with room around it, and 148px too wide once six word-segments have to
    share a 480px rail with a label, a field and a unit. SegmentedItem, the layer switcher's
    container, has always been 11,4 at FontSizeBody — the mock's own `padding: 4px 11px` — and that
    is what these two strips are: segments in a row, not latches on a panel. Measured at the rail's
    floor, the two setters below take 35px off the line — six word-segments, ~7px each.

    ONLY THE METRICS ARE OVERRIDDEN. Every colour, every state and the `:not(:disabled)` qualifier
    on the accent face come from ToggleSegment, so the composer's `tap` and the pedal editor's
    `Macro` latch cannot drift apart in face while differing in size — which is the whole reason
    this is a derived theme rather than a second copy of that ramp.
  -->
  <ControlTheme x:Key="ComposerSegment" TargetType="Button" BasedOn="{StaticResource ToggleSegment}">
    <Setter Property="Padding" Value="11,4" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
  </ControlTheme>

  <!--
    ONE DIRECTION ARROW of the lighting tab's direction row (mockup 2f: "Direction" with
    `← → ↑ ↓`). A square button carrying one `IconArrow…` mark, on the toggle's own neutral/accent
    ramp, so "this is the direction the effect runs" reads the same way "this co-trigger is on"
    does.

    THE `.unavailable` STATE IS A DELIBERATE EXCEPTION TO A DESIGN LAW, and the design is the one
    making it. The law is "capability-driven UI: absent features are not shown, not disabled"
    (docs/design/README.md); 2f overrides it for this one control, verbatim: "Directions a mode
    can't use stay in place, struck through — the row never changes shape as you move down the
    list." The reason is in the sentence: the mode rail is a column of fourteen rows the user
    scrubs through, and a direction row that shrank from four arrows to two and back again as the
    selection moved would make the panel jump under the pointer. So the slot is KEPT and the
    unavailable arrow is struck through in it.

    It is NOT `:disabled`, and that distinction is the whole of this state. A disabled control is
    dimmed and says nothing about why; this one carries a mark that says "this mode does not run
    that way", which is a fact about the mode rather than about the app's willingness. It is also
    not interactive and not focusable — `Focusable` and `IsHitTestVisible` are set by the class
    itself rather than left to the view, because a struck-through arrow that could still be tabbed
    to and pressed would be a lie the view could forget to tell.

    THE STRIKE IS A DIAGONAL, not the horizontal rule "struck through" usually means. Two of the
    four marks ARE a horizontal line through the middle of the box — `IconArrowLeft` and
    `IconArrowRight` — so a horizontal strike would land exactly on the shaft and be invisible on
    half the row. The slash is drawn corner to corner, which crosses all four at an angle.
  -->
  <ControlTheme x:Key="DirectionSegment" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="Background" Value="{DynamicResource SurfaceBarBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderRaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="Transitions" Value="{x:Null}" />

    <!-- Square, and sized by its padding rather than by a Width: a 16px mark inside 7 either side
         is 30, which is the row's own rhythm and not one of the six spacing steps, exactly as
         PaddingButton is not. -->
    <Setter Property="Padding" Value="7" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />

    <Setter Property="Template">
      <ControlTemplate TargetType="Button">
        <Border x:Name="Root"
                ClipToBounds="False"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <Panel>
            <ContentPresenter x:Name="Label"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />

            <!-- The strike. Transparent until `.unavailable` paints it, so acquiring it costs no
                 reflow and the slot is the same size either way — which is the point of the whole
                 state. `Stretch="Fill"` maps the unit diagonal onto whatever the mark's box turns
                 out to be, so the line is corner to corner at any scale; the negative margin takes
                 it back over the Root's padding so it crosses the button rather than the icon. -->
            <Path x:Name="Strike"
                  Margin="-4"
                  IsHitTestVisible="False"
                  Stretch="Fill"
                  Data="M 0,1 L 1,0"
                  Stroke="Transparent"
                  StrokeThickness="1" />
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover:not(:pressed):not(.selected)">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="^:pointerover:not(:pressed):not(.selected):not(:focus-visible)">
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceLineHighBrush}" />
    </Style>

    <Style Selector="^:pressed:not(.selected)">
      <Setter Property="Background" Value="{DynamicResource SurfaceLineBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- The chosen direction. `:not(:disabled)` for the reason ToggleSegment's carries it — Avalonia
         walks BasedOn first — and `:not(.unavailable)` because the two could be written together by
         a view model that had not yet cleared a selection the new mode cannot honour, and a struck
         arrow wearing the full accent fill would be the worst of both statements. -->
    <Style Selector="^.selected:not(:disabled):not(.unavailable)">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="^.selected:not(:disabled):not(.unavailable):not(:focus-visible)">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentSelectedRingBrush}" />
    </Style>

    <!-- Struck through, in place. It keeps its box and its border — the row must not change shape —
         and loses its face, its interactivity and its tab stop. The pointer states above need no
         `:not(.unavailable)` qualifier: a control that is not hit-testable can never raise them. -->
    <Style Selector="^.unavailable">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceLineBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="^.unavailable /template/ Path#Strike">
      <Setter Property="Stroke" Value="{DynamicResource TextDisabledBrush}" />
    </Style>
  </ControlTheme>

  <!--
    ONE SPEED BAR. The lighting tab's speed control is nine of these in a row with a mono
    `Speed 6 / 9` beside it: "speed as segmented bars (accent-filled)" (docs/design/handoff.md:150,
    and mockup 2f draws the readout).

    A bar is filled when it is at or below the chosen speed, which is a fact about the whole row
    rather than about one bar — so it arrives as the `.filled` class from the view model, and this
    theme knows only "filled" and "not". It is a Button and not a ListBoxItem for that reason: the
    control is not one-of-N (clicking bar 6 selects speeds 1..6), so a SelectingItemsControl would
    have to fight its own selection model to draw it.

    Unfilled is the INSET surface rather than a transparent one: the row has to read as a track
    with a level in it even at speed 1, where eight of the nine bars are empty.
  -->
  <ControlTheme x:Key="SpeedBar" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="Background" Value="{DynamicResource SurfaceInsetBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SurfaceLineBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusChip}" />
    <Setter Property="Transitions" Value="{x:Null}" />

    <!-- A bar, not a button: it holds no content at all, so its size is its own and there is no
         padding for a label to sit in. 10 x 18 is the mock's own proportion — a shape wide enough
         to hit and tall enough to read as a level. -->
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />

    <Style Selector="^:pointerover:not(:pressed):not(.filled)">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    </Style>
    <Style Selector="^:pointerover:not(:pressed):not(.filled):not(:focus-visible)">
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceLineHighBrush}" />
    </Style>

    <Style Selector="^:pressed:not(.filled)">
      <Setter Property="Background" Value="{DynamicResource SurfaceLineBrush}" />
    </Style>

    <!-- At or below the chosen speed. `:not(:disabled)` for the reason every accent state in this
         file carries it: BaseButton's disabled face is applied first, and an unqualified class
         would leave a dead control wearing a live accent. -->
    <Style Selector="^.filled:not(:disabled)">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="^.filled:not(:disabled):not(:focus-visible)">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentSelectedRingBrush}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
