<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:KinesisEdit.ViewModels"
             xmlns:controls="clr-namespace:KinesisEdit.Controls"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="KinesisEdit.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
  <Panel>
    <!--
      A card exists for every device the last scan found, and only for those; a scan updates each
      card in place and never rebuilds the list, so scroll offset and the control under the pointer
      survive it, and a newly found device inserts at the end.
    -->
    <Grid RowDefinitions="Auto,*" IsVisible="{Binding HasDevices}" Margin="24">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Bottom">
          <TextBlock Text="{Binding HeaderTitle}" Classes="pageTitle" />
          <TextBlock Text="{Binding HeaderSubtitle}" Classes="meta muted" />
        </StackPanel>

        <controls:AccessibleButton Grid.Column="1"
                                   Classes="secondary"
                                   VerticalAlignment="Bottom"
                                   Content="{Binding ScanAllCaption}"
                                   Command="{Binding ScanCommand}" />
      </Grid>

      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Devices}">
          <!--
            Two columns at `CardGridGap`, with no trailing gutter.

            Avalonia's UniformGrid has no spacing property, so the gap is a right-and-bottom margin
            on every cell (`CardGridCellGap`) and the panel carries the negative of it
            (`CardGridPanelBleed`) - two Thicknesses because a Margin cannot be composed out of the
            x:Double in markup; Themes/Geometry.axaml declares all three together and a test pins
            them to one number. A negative margin inflates the slot a Layoutable is measured and
            arranged in, so the panel is laid out one gap wider and one gap taller than the space
            the ScrollViewer gives it and the last column's card ends exactly on the viewport's
            right edge: the gap lands only *between* cells, nothing is clipped, and the scroll
            extent stops at the bottom of the last row rather than one gap below it.

            The style is scoped to the item containers (`ItemsControl > ContentPresenter`) rather
            than to every ContentPresenter in the subtree - each card contains several of them,
            inside the buttons' own templates. The child combinator is the *logical* parent, and a
            generated container's logical parent is the ItemsControl rather than the panel it is
            arranged in, which is why this cannot name the UniformGrid.

            Top-aligned, because a UniformGrid spreads its rows over whatever height it is arranged
            at and the ScrollViewer arranges its content at the full viewport when the content is
            shorter: one row of cards in a tall window would otherwise sit in the middle of a row
            half the window high, and two rows would be 100px apart.
          -->
          <ItemsControl.Styles>
            <Style Selector="ItemsControl > ContentPresenter">
              <Setter Property="Margin" Value="{StaticResource CardGridCellGap}" />
            </Style>
          </ItemsControl.Styles>
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="2" Margin="{StaticResource CardGridPanelBleed}" VerticalAlignment="Top" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <!-- specs/11-feature-dialogs.md §11.8 troubleshoot panel while nothing is detected. It comes
         back when the last device goes: the roster is what the last scan found, so an unplugged
         board leaves the grid empty rather than leaving a card behind. -->
    <ContentControl Content="{Binding EmptyState}" IsVisible="{Binding IsEmpty}" Margin="24" />
  </Panel>
</UserControl>
