<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:KinesisEdit.ViewModels"
             xmlns:controls="clr-namespace:KinesisEdit.Controls"
             mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="90"
             x:Class="KinesisEdit.Views.LoadingView"
             x:DataType="vm:LoadingViewModel">
  <!-- Progress indicator with a caller-supplied caption (specs/11-feature-dialogs.md §11.9,
       "Loading"). Mockup 1k draws it as "Loading · blocking": the card sits on the same scrim the
       message box uses, so the app takes no input while it is up. The scrim belongs to
       NotificationOverlay; this view is the card, and it casts the modal shadow because it floats
       at the same height. -->
  <Border Classes="overlayCard modalCard" MinWidth="240">
    <StackPanel Spacing="{DynamicResource Space8}">
      <!-- The design's one busy affordance: a 14px ring with a quadrant missing, turning once every
           1.1s. `.spinner` (Styles/Icons.axaml) carries the geometry, the box and the rotation, so
           the only thing left to name here is the accent it turns in. -->
      <controls:Icon Classes="spinner"
                     Stroke="{DynamicResource AccentBrush}"
                     HorizontalAlignment="Center" />
      <TextBlock Text="{Binding Caption}"
                 Classes="modalBody"
                 HorizontalAlignment="Center"
                 TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</UserControl>
