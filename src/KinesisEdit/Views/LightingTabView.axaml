<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:KinesisEdit.ViewModels"
             xmlns:views="clr-namespace:KinesisEdit.Views"
             xmlns:controls="clr-namespace:KinesisEdit.Controls"
             xmlns:data="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="620"
             x:Class="KinesisEdit.Views.LightingTabView"
             x:DataType="vm:LightingTabViewModel">
  <!-- The editor's Lighting tab (specs/07-lighting.md §3, §4): the layer switch, the mode menu,
       the per-mode parameter panels, and — for the two per-key modes — the keyboard picture, the
       zone buttons and "Reset All". Which panels appear is the view model's Panels value; nothing
       here knows a mode name. -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="12" Margin="0,4">

      <!-- Demo mode: everything is explorable, nothing is written (03 §3.5). -->
      <Border Classes="card" IsVisible="{Binding HasStatusMessage}">
        <TextBlock Text="{Binding StatusMessage}" Classes="body muted" TextWrapping="Wrap" />
      </Border>

      <!-- Layer switch. The two layers are fully independent (§4), and the Fn segment is disabled
           below the LED 1.0.44 gate (§3), which is also what hides the base-colour swatch. -->
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <!-- The same segmented control the Keys tab's layer switch is, for the same reason: one of
             N, one tab stop. `SelectedItem` reads the panel one way — SelectLayer owns that
             property — and the selection change runs the command the pills used to. -->
        <ListBox Theme="{StaticResource SegmentedControl}"
                 ItemsSource="{Binding Layers}"
                 SelectedItem="{Binding SelectedLayer, Mode=OneWay}"
                 SelectionChanged="OnLayerSelectionChanged">
          <!-- The Fn segment below the LED 1.0.44 gate: shown and dimmed rather than hidden,
               because the layer exists and the reason is printed beside it. Scoped to this list, so
               it cannot outrank another one's container theme. -->
          <ListBox.Styles>
            <Style Selector="ListBoxItem" x:DataType="vm:LightingLayerViewModel">
              <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:LightingLayerViewModel">
              <TextBlock Text="{Binding Caption}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Text="{Binding LayerLockHint}"
                   Classes="body muted"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   IsVisible="{Binding !IsLayerCustomizationAvailable}" />
      </StackPanel>

      <Grid ColumnDefinitions="180,*,Auto" ColumnSpacing="16">

        <!-- The mode menu (§3): membership and firmware gating are the view model's. -->
        <!-- Tighter than a card's own padding: the rows inside carry theirs, so the menu would
             otherwise read as double-inset. 8 is the spacing scale's second step. -->
        <Border Grid.Column="0" Classes="card" Padding="8" VerticalAlignment="Top">
          <ItemsControl ItemsSource="{Binding Modes}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:LightingModeViewModel">
                <Button Classes="modeOption"
                        Classes.selected="{Binding IsSelected}"
                        HorizontalAlignment="Stretch"
                        Command="{Binding $parent[views:LightingTabView].((vm:LightingTabViewModel)DataContext).SelectModeCommand}"
                        CommandParameter="{Binding}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <!-- The mode's mark, which "draws the motion rather than naming it twice"
                         (docs/design/handoff.md). Two Icons in one cell because thirteen of the
                         sixteen marks are outlines and three are solids, and those are different
                         properties on an Icon: the converter answers only the half the mode is
                         drawn in, so the other draws nothing. Stroking a ring *and* filling it
                         would turn it into a disc, which is why they are never both answered. -->
                    <Panel Width="{DynamicResource IconSize}"
                           Height="{DynamicResource IconSize}"
                           VerticalAlignment="Center">
                      <controls:Icon Classes="modeMark"
                                     Classes.selected="{Binding IsSelected}"
                                     Data="{Binding Mode, Converter={StaticResource LightingModeMark}, ConverterParameter=Stroke}" />
                      <controls:Icon Classes="modeMark filled"
                                     Classes.selected="{Binding IsSelected}"
                                     Data="{Binding Mode, Converter={StaticResource LightingModeMark}, ConverterParameter=Fill}" />
                    </Panel>

                    <TextBlock Text="{Binding Caption}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <!-- The parameter panels of the selected mode. -->
        <StackPanel Grid.Column="1" Spacing="14" VerticalAlignment="Top">

          <!-- The two colour swatches. The picker edits whichever one is selected; for the per-key
               modes only the effect swatch exists and it is the colour a click paints with (§4). -->
          <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding Panels.ShowsAnyColor}">
            <Button Classes="colorSlot"
                    Classes.selected="{Binding EffectColor.IsSelected}"
                    IsVisible="{Binding EffectColor.IsVisible}"
                    Command="{Binding SelectColorSlotCommand}"
                    CommandParameter="{Binding EffectColor}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="colorSwatchFill"
                        Background="{Binding EffectColor.ColorHex, Converter={StaticResource HexColorToBrush}}" />
                <TextBlock Text="{Binding EffectColor.Caption}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Classes="colorSlot"
                    Classes.selected="{Binding BaseColor.IsSelected}"
                    IsVisible="{Binding BaseColor.IsVisible}"
                    Command="{Binding SelectColorSlotCommand}"
                    CommandParameter="{Binding BaseColor}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="colorSwatchFill"
                        Background="{Binding BaseColor.ColorHex, Converter={StaticResource HexColorToBrush}}" />
                <TextBlock Text="{Binding BaseColor.Caption}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>

          <!-- Speed 1-9 (§2.1). -->
          <Grid ColumnDefinitions="80,*,32" IsVisible="{Binding Panels.ShowsSpeed}">
            <TextBlock Grid.Column="0" Text="SPEED" Classes="sectionLabel" VerticalAlignment="Center" />
            <Slider Grid.Column="1"
                    Minimum="{Binding MinimumSpeed}"
                    Maximum="{Binding MaximumSpeed}"
                    Value="{Binding Speed}"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    VerticalAlignment="Center" />
            <TextBlock Grid.Column="2"
                       Text="{Binding Speed}"
                       Classes="monoValue"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
          </Grid>

          <!-- Direction (§3). Rebound's two entries read "Horizontal"/"Vertical".

               Deliberately still a row of buttons rather than the segmented control the layer
               switch became: the panel replaces the whole Directions collection whenever the mode
               changes and states the chosen one only as each entry's IsSelected, so a
               SelectingItemsControl would have nothing to bind its selection to — and, with
               AlwaysSelected, would silently write direction 0 into the model on every mode change.
               `ToggleSegment` is the same "chosen is accent-filled" face, driven by that class. -->
          <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding Panels.ShowsDirection}">
            <TextBlock Text="DIRECTION" Classes="sectionLabel" Width="80" VerticalAlignment="Center" />
            <ItemsControl ItemsSource="{Binding Directions}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:LightingDirectionViewModel">
                  <Button Classes="toggleSegment"
                          Classes.selected="{Binding IsSelected}"
                          Content="{Binding Caption}"
                          Command="{Binding $parent[views:LightingTabView].((vm:LightingTabViewModel)DataContext).SelectDirectionCommand}"
                          CommandParameter="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- Zone buttons and "Reset All": Freestyle and Breathe only (§3, §4). -->
          <StackPanel Spacing="8" IsVisible="{Binding Panels.ShowsZones}">
            <TextBlock Text="ZONES" Classes="sectionLabel" />
            <ItemsControl ItemsSource="{Binding Zones}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:LightingZoneViewModel">
                  <Button Classes="zoneButton"
                          Content="{Binding Caption}"
                          Command="{Binding $parent[views:LightingTabView].((vm:LightingTabViewModel)DataContext).ApplyZoneCommand}"
                          CommandParameter="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="{x:Static vm:LightingTabViewModel.ResetAllCaption}"
                    Command="{Binding ResetAllCommand}"
                    HorizontalAlignment="Left"
                    IsVisible="{Binding Panels.ShowsResetAll}" />
          </StackPanel>
        </StackPanel>

        <!-- The picker itself, shown whenever there is a colour to edit or keys to paint —
             ShowsAnyColor covers both, because a per-key mode's "effect colour" is the colour a
             click paints with (§4). Hidden in Disabled/Spectrum/Wave/Pulse, where dragging the
             ring would write nowhere. The binding walks back up to the tab's DataContext because
             this element's own is the picker. -->
        <controls:ColorPickerView Grid.Column="2"
                                  DataContext="{Binding Picker}"
                                  IsVisible="{Binding $parent[views:LightingTabView].((vm:LightingTabViewModel)DataContext).Panels.ShowsAnyColor}"
                                  VerticalAlignment="Top" />
      </Grid>

      <!-- Per-key colouring (§4): the same generic picture the Keys tab uses, with the click
           wired to the colour-assign command instead of the remap one — and with the LED strip
           asked for, which is what makes this picture a lighting surface and the Keys tab's not
           (an unlit key hatches here and shows nothing at all there). -->
      <StackPanel Spacing="8" IsVisible="{Binding Panels.ShowsPerKeyColors}">
        <TextBlock Text="Click a key to paint it with the selected colour; black erases it."
                   Classes="body muted" />

        <Border Classes="keyboardBoard"
                IsVisible="{Binding Board, Converter={x:Static data:ObjectConverters.IsNotNull}}">
          <controls:KeyboardView DataContext="{Binding Board}"
                                 ShowsLedStrips="True"
                                 KeySelectedCommand="{Binding $parent[views:LightingTabView].((vm:LightingTabViewModel)DataContext).AssignKeyColorCommand}" />
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
