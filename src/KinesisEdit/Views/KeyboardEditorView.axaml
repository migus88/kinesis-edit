<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:KinesisEdit.ViewModels"
             xmlns:views="clr-namespace:KinesisEdit.Views"
             xmlns:controls="clr-namespace:KinesisEdit.Controls"
             xmlns:data="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="620"
             x:Class="KinesisEdit.Views.KeyboardEditorView"
             x:DataType="vm:KeyboardEditorViewModel">
  <!-- The per-device editor of specs/10-apps-and-ui.md, on the redesign's editor-shell layout
       (docs/design/handoff.md § "Editor shell", mockups 1e/1f/2a): a 46px toolbar, a 38px tab bar,
       the Demo Mode bar, then the content. The keyboard picture the remap workflow runs on, the
       macro library of the Macros tab, the Lighting and Settings panels, and the feature panels of
       specs/11-feature-dialogs.md rendered as an overlay over all of it. The picture itself is the
       generic KeyboardView; everything device-specific reaches it as data.

       LAYOUT SHAPE, because two later issues build on it. The chrome is FULL-BLEED — the toolbar,
       the tab bar and the Demo Mode bar run edge to edge — and only the content area below them is
       padded. The root Panel with the overlay scrim as a sibling of the grid is load-bearing: the
       spec 11 panels render into it.

         Row 0  toolbar        46  Home | device | mount path .......... Save | status chip
         Row 1  tab bar        38  Layout Macros [Lighting] [Settings] ... LAYER (segments + kbd)
         Row 2  Demo Mode bar      only in demo mode
         Row 3  advisory strip 30  the open section's one calm sentence; collapses when it has none
         Row 4  content            padded 24,16: the sections — the Layout/Macros board is the
                                   keyboard canvas with its legend row under it, centred both
                                   ways — then the provisional action row and the invalid-line
                                   block -->
  <Panel>
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">

      <!-- ===== Row 0: the editor toolbar ====================================================
           It REPLACES the shell's app bar rather than sitting under it: the mockups draw exactly
           one 46px bar while editing, carrying the same things. MainWindow hides its own for as
           long as an editor ProvidesOwnChrome (MainWindowViewModel.IsShellChromeVisible).

           NO EJECT BUTTON, though mockup 1e draws one. "Nothing ejects implicitly" — eject is the
           dashboard card's own deliberate action (issue #88). Recorded as a deliberate deviation
           in docs/app/design-system.md.

           Home and the status chip come from the shell through `Shell` (IShellChrome), never from
           a $parent[MainWindow] lookup: every headless suite renders this view standalone, where
           such a lookup resolves to nothing and both would render blank. -->
      <Border Grid.Row="0"
              Background="{DynamicResource SurfaceBarBrush}"
              BorderBrush="{DynamicResource SurfaceLineBrush}"
              BorderThickness="0,0,0,1"
              Height="{DynamicResource HeightToolbar}"
              Padding="16,0">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <Button Content="Home" Classes="secondary" Command="{Binding Shell.HomeCommand}" />

            <Border Width="1"
                    Height="20"
                    Background="{DynamicResource SurfaceLineBrush}"
                    VerticalAlignment="Center" />

            <TextBlock Text="{Binding DeviceName}" Classes="toolbarDevice" VerticalAlignment="Center" />

            <!-- The mount path is a value that exists verbatim on the machine, so it is mono (the
                 mono law). Hidden in demo mode and on a device with no drive, where there is no
                 path to name. -->
            <TextBlock Text="{Binding MountPath}"
                       Classes="monoValue muted"
                       VerticalAlignment="Center"
                       IsVisible="{Binding HasMountPath}" />

            <TextBlock Text="{Binding ProfileCaption}"
                       Classes="meta muted"
                       VerticalAlignment="Center"
                       IsVisible="{Binding ProfileCaption, Converter={x:Static data:StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock Text="{Binding RemapCounterCaption}" Classes="meta muted" VerticalAlignment="Center" />
            <TextBlock Text="{Binding MacroCounterCaption}" Classes="meta muted" VerticalAlignment="Center" />

            <TextBlock Text="{x:Static vm:KeyboardEditorViewModel.SavingCaption}"
                       Classes="meta muted"
                       VerticalAlignment="Center"
                       IsVisible="{Binding IsBusy}" />

            <!-- Save "turns amber whenever the session is dirty" (handoff § Editor shell). The
                 class is all this view says; the amber ramp is painted inside the
                 PrimaryActionButton control theme, which is the only layer allowed to name a
                 template part. -->
            <Button Content="Save"
                    Classes="primaryAction"
                    Classes.dirty="{Binding IsDirty}"
                    Command="{Binding SaveCommand}" />

            <views:StatusChipView DataContext="{Binding Shell}" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- ===== Row 1: the tab bar =============================================================
           The TabStrip control theme already carries the fixed 38 height, the inset face, the
           hairline under it, the padding and the 500-weight-plus-2px-accent-underline active state,
           so it is used as it is and paints the whole bar: it is stretched across the row and the
           layer switcher is laid OVER its right end, rather than the bar being re-implemented as a
           Border with a transparent strip inside it.

           The strip carries only sections that work — a feature the board lacks is not rendered at
           all (EditorTabViewModel.CreateAll), which is why there is no longer a scoped TabStripItem
           style binding IsEnabled here. -->
      <Grid Grid.Row="1">
        <!-- A real TabStrip: the header row of a tab control with no content host, which is exactly
             what this is — the strip selects, and the Panel below toggles which section is visible.
             `SelectedValue` rides the view model's own EditorTab, mapped through each entry's Tab,
             so the strip and the section stay one value; the click still runs SelectTabCommand. -->
        <TabStrip Theme="{StaticResource TabStrip}"
                  ItemsSource="{Binding Tabs}"
                  SelectedValueBinding="{Binding Tab, DataType=vm:EditorTabViewModel}"
                  SelectedValue="{Binding SelectedTab, Mode=OneWay}"
                  SelectionChanged="OnTabSelectionChanged">
          <TabStrip.ItemTemplate>
            <DataTemplate DataType="vm:EditorTabViewModel">
              <TextBlock Text="{Binding Caption}" />
            </DataTemplate>
          </TabStrip.ItemTemplate>
        </TabStrip>

        <!-- The layer switch, built from the model's layers, so it is two segments on a Freestyle
             Edge RGB and five on an Advantage 360 (issue #41).

             A ListBox rather than a row of buttons: the switch is one-of-N, which is what a
             SelectingItemsControl is, and it buys the whole group one tab stop with arrow-key
             movement inside it. `SelectedItem` reads the view model one way — the property is
             read-only, and SelectLayer is the only thing allowed to move it — while the selection
             change runs the very command the buttons used to.

             NOT ON THE LIGHTING TAB. There are two different "layers" in this app and they are not
             the same object: this one is the LAYOUT layer (layoutN.txt, what a key does), and the
             Lighting tab has its own switch for the LED file's layer (ledN.txt, what a key looks
             like). Drawn together they are two identical Top/Fn segment pairs a few hundred pixels
             apart, and only one of them does anything while lighting is open — mockup 2f draws one
             switch, relabelled "Lighting layer", and that is the tab's own. So the shell's yields
             the row while Lighting has the screen, exactly as the whole app bar yields to the
             editor's chrome (IShellChrome): one bar, one status chip, and now one layer switch. -->
        <StackPanel Orientation="Horizontal"
                    Spacing="8"
                    Margin="0,0,12,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    IsVisible="{Binding SelectedTab, Converter={StaticResource EnumMatch}, ConverterParameter='Keys,Macros,Settings'}">
          <TextBlock Text="LAYER" Classes="sectionLabel" VerticalAlignment="Center" />

          <ListBox Theme="{StaticResource SegmentedControl}"
                   ItemsSource="{Binding Layers}"
                   SelectedItem="{Binding SelectedLayer, Mode=OneWay}"
                   SelectionChanged="OnLayerSelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:KeyboardLayerViewModel">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding Caption}" VerticalAlignment="Center" />
                  <!-- The ⌥n legend of mockup 1f. The legend is display text; the accelerator it
                       names is wired by the editor's keyboard grammar, which maps ⌥ to Alt on every
                       platform (KinesisEdit.Input.EditorShortcuts).

                       The ⌥ is DRAWN, not typed: U+2325 is in neither embedded IBM Plex family, so
                       the character would be tofu on the one platform that shows it. The chip's
                       Content is therefore a panel of mark-plus-text rather than a string — its
                       template ends in a plain ContentPresenter, so this needs nothing from the
                       ControlTheme and names no template part. Windows and Linux hide the mark and
                       read `Alt+1`; the mark cannot inherit the chip's Foreground (an Icon paints
                       from Stroke), which is what `Icon.kbdMark` in Styles/Editor.axaml is for. -->
                  <ContentControl Classes="kbd" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                      <controls:Icon Classes="kbdMark"
                                     Data="{DynamicResource IconOption}"
                                     IsVisible="{Binding ShowsOptionMark}"
                                     VerticalAlignment="Center" />
                      <TextBlock Text="{Binding ShortcutHint}" VerticalAlignment="Center" />
                    </StackPanel>
                  </ContentControl>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Grid>

      <!-- ===== Row 2: the Demo Mode bar =======================================================
           Demo mode never touched the drive and can never save (specs/03-vdrive-and-files.md §3.5).
           Purple, not amber: "nothing is written" is its own state in the design's four-status
           vocabulary, and amber is reserved for advisories.

           BOTH of mockup 1f's actions, in its order: `Export layout to file…` then
           `Connect a device`. Export is live here — a demo board with fixtures opens a real session
           over the synthetic v-Drive, and an export writes to a folder the user picked rather than
           to the drive (specs/11-feature-dialogs.md §11.5), so 03 §3.5 is untouched by it. Save and
           Import are the two that stay refused, and neither is drawn on this bar. -->
      <Border Grid.Row="2"
              Background="{DynamicResource StatusDemoTintBrush}"
              BorderBrush="{DynamicResource StatusDemoTintBorderBrush}"
              BorderThickness="0,0,0,1"
              Padding="24,8"
              IsVisible="{Binding IsDemoMode}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0"
                     Text="{x:Static vm:KeyboardEditorViewModel.DemoModeBarMessage}"
                     Classes="body statusDemo"
                     TextWrapping="Wrap"
                     VerticalAlignment="Center" />

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Content="{x:Static vm:KeyboardEditorViewModel.DemoModeExportCaption}"
                    Classes="secondary"
                    Command="{Binding ExportCommand}" />

            <Button Content="{x:Static vm:KeyboardEditorViewModel.DemoModeConnectCaption}"
                    Classes="secondary"
                    Command="{Binding Shell.HomeCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- ===== Row 3: the advisory strip ======================================================
           One strip serves all four tabs: its sentence and its count are the *open* section's, and
           the whole strip hides when that section has nothing to say — so this row is 30px or 0px
           and the board below it never shifts as the user edits. The row is Auto rather than 30
           because the `advisory_detail` preference lets the strip wrap to its full text and grow;
           at its default (one trimmed line) the height is the same 30px it always was.

           It is full-bleed like the chrome above it, and it sits above the content rather than
           inside it because it belongs to the section, not to the board (mockup 1e draws it above
           the board; the Macros and Settings tabs need the same strip). -->
      <views:AdvisoryStripView Grid.Row="3" DataContext="{Binding AdvisoryStrip}" />

      <!-- ===== Row 4: the content ============================================================
           The only padded region; everything above it is full-bleed chrome. -->
      <Grid Grid.Row="4" RowDefinitions="*,Auto,Auto" Margin="24,16">

        <Panel Grid.Row="0">
          <TextBlock Text="Loading profile..."
                     Classes="body muted"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     IsVisible="{Binding IsLoading}" />

          <!-- A save is in flight: the picture stays on screen but nothing may be edited under it. -->
          <Panel IsVisible="{Binding !IsLoading}" IsEnabled="{Binding !IsBusy}">
            <!-- TWO COLUMNS: the board, and the 268px key inspector rail beside it. The rail is
                 Auto and collapses itself on the selection, so a column with nothing in it measures
                 zero and the board takes the width back. There is deliberately NO clipping container
                 between the rail and the board: ClipToBounds is false the whole way down the board
                 chain (Controls/KeyboardView.axaml), and a Border here would start cutting caps off.

                 THE BOARD IS THE LAYOUT TAB'S ALONE SINCE ISSUE #93. The Macros tab used to dock its
                 editor beside this picture; it is a library now (mockup 1i) and takes the whole
                 content area for itself, below. -->
            <Grid ColumnDefinitions="*,Auto"
                  IsVisible="{Binding SelectedTab, Converter={StaticResource EnumMatch}, ConverterParameter=Keys}">
              <Grid Grid.Column="0" RowDefinitions="Auto,*">
                <!--
                  No "Esc cancels" here: while a key is listening the capture service swallows every
                  physical key, Escape included, so Escape is assigned like any other key (a keyboard
                  must be able to carry an Escape remap). Cancelling is therefore a pointer action.
                -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Spacing="12"
                            Margin="0,0,0,8"
                            VerticalAlignment="Center"
                            IsVisible="{Binding IsListening}">
                  <!-- The banner pulses with the cap it belongs to; the class is bound rather than
                       fixed so the animation only runs while something is actually listening. -->
                  <TextBlock Text="Press a key to assign it to the highlighted key."
                             Classes="control statusWarning"
                             Classes.recording="{Binding IsListening}"
                             VerticalAlignment="Center" />
                  <Button Content="Cancel"
                          Command="{Binding CancelRemapCommand}"
                          VerticalAlignment="Center" />
                </StackPanel>

                <!-- The keyboard canvas and its legend row, centred as one block in the content
                     area (handoff § "Screens → 3. Layout tab": "Content = keyboard canvas
                     (centered, both split halves as separate panels with 26px gutter) + legend
                     row"). The two are one StackPanel so the row is exactly as wide as the board
                     and its ends line up with the board's, which is how mockups 1e/2a draw it.

                     NO OUTER FRAME. The picture draws its own bordered section panels now
                     (Controls/KeyboardView.axaml), so the `keyboardBoard` inset surround this used
                     to carry would be a second frame around them; the canvas here is the content
                     area itself. The Lighting tab keeps the surround, because its board sits inside
                     a column of controls rather than on a canvas of its own. -->
                <StackPanel Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsVisible="{Binding SelectedLayer, Converter={x:Static data:ObjectConverters.IsNotNull}}">
                  <controls:KeyboardView DataContext="{Binding SelectedLayer}"
                                         HorizontalAlignment="Center"
                                         KeySelectedCommand="{Binding $parent[views:KeyboardEditorView].((vm:KeyboardEditorViewModel)DataContext).SelectKeyCommand}" />

                  <!-- ~14px below the board, as the mock spaces it. The row counts the state of
                       the layer on screen and carries `Copy key…` and `Reset layer`. -->
                  <views:BoardLegendView DataContext="{Binding BoardLegend}" Margin="0,14,0,0" />
                </StackPanel>
              </Grid>

              <!-- The key inspector rail (mockups 1e/2a). It is NOT modal: no scrim, no overlay
                   host, and the board to its left stays clickable the whole time it is open.

                   NO GUTTER. The rail carries its own inset surface and a hairline down its left
                   edge (`inspectorRail`), which is how mockup 1e separates it — and every pixel
                   spent on a margin here comes out of the board's column, where the legend row under
                   the picture is already exactly as wide as its own counts and actions.

                   IsVisible is bound HERE as well as inside the rail: the rail collapses its own
                   frame, which is what makes it usable on its own, but only an invisible element
                   lets this Auto column measure zero. -->
              <views:KeyInspectorView Grid.Column="1"
                                      DataContext="{Binding Inspector}"
                                      IsVisible="{Binding IsOpen}" />
            </Grid>

            <!-- The Macros tab (mockup 1i) — a library, not an editor, and since issue #93 it takes
                 the whole content area rather than docking beside the board. It draws no board of
                 its own: `Pick another key` and `＋ Record a macro` both leave for the Layout tab,
                 where the board and the one recording surface in this app are.

                 A bare content host, exactly as the key inspector hosts its own panels, because
                 ViewLocator resolves MacroLibraryViewModel to Views/MacroLibraryView by name. -->
            <ContentControl Content="{Binding MacroLibraryPanel}"
                            IsVisible="{Binding IsMacroLibraryVisible}" />

            <!-- The lighting editor of specs/07-lighting.md §3/§4; the panels are the mode's, so this
                 is one ContentControl and the panel decides what it shows. -->
            <ContentControl Content="{Binding Lighting}"
                            IsVisible="{Binding SelectedTab, Converter={StaticResource EnumMatch}, ConverterParameter=Lighting}" />

            <!-- The keyboard settings of specs/08-settings.md §5; the rows are the device's, so this
                 is one ContentControl and the panel decides what it shows. -->
            <ContentControl Content="{Binding Settings}"
                            IsVisible="{Binding SelectedTab, Converter={StaticResource EnumMatch}, ConverterParameter=Settings}" />
          </Panel>
        </Panel>

        <!-- STILL PROVISIONAL, and smaller again. Two more buttons have reached their real homes
             with the key inspector rail (issue #92): `Reset Key` is now the rail footer's
             `Revert key`, and `Tap and Hold` is a rail panel rather than a modal — both run the
             very same commands from there. `Reset Layer` left earlier, for the legend row under the
             board (#91).

             `Insert Delay` left with issue #93: §11.3 is edited in place on the key inspector's
             Macro panel now, so there is no command left for a button here to run.

             What is left waits for the rest of #93, which owns the editor-level action bar:
             `Reset Layout`, §11.6's macro-insertion picker, and Import/Export.

             Nothing here is the design's shape — it exists so every action stays reachable and
             keeps working in the meantime, on every tab, which is why it sits under the whole
             content area rather than under the board.

             Every button reports its own availability through its command's CanExecute, so there is
             no visibility logic here. -->
        <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,12,0,0">
          <Button Content="Reset Layout" Command="{Binding ResetLayoutCommand}" Margin="6,0,0,4" />
          <Button Content="Special Action" Command="{Binding InsertSpecialActionCommand}" Margin="6,0,0,4" />
          <Button Content="Export" Command="{Binding ExportCommand}" Margin="6,0,0,4" />
          <Button Content="Import" Command="{Binding ImportCommand}" Margin="6,0,0,4" />
        </WrapPanel>

        <!-- Lines of the loaded file the parser could not apply (specs/04-layout-files.md §5.2). They
             are collapsed by default but never dropped silently. -->
        <Expander Grid.Row="2"
                  Margin="0,12,0,0"
                  HorizontalAlignment="Stretch"
                  IsVisible="{Binding HasInvalidLines}">
          <Expander.Header>
            <TextBlock Text="Some lines of this profile could not be applied"
                       Classes="control statusWarning" />
          </Expander.Header>
          <ItemsControl ItemsSource="{Binding InvalidLineMessages}" MaxHeight="160">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="x:String">
                <TextBlock Text="{Binding}" TextWrapping="Wrap" Classes="monoValueSmall muted" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Expander>
      </Grid>
    </Grid>

    <!-- The feature panels of spec 11, hosted inline rather than as separate windows so keystroke
         capture never has to cross a window boundary. ViewLocator resolves the open overlay's own
         view; the scrim below it swallows every click aimed at the editor underneath. -->
    <Border Classes="overlayScrim"
            Classes.open="{Binding HasActiveOverlay}"
            IsVisible="{Binding HasActiveOverlay}">
      <ContentControl Classes="overlayHost"
                      Classes.open="{Binding HasActiveOverlay}"
                      Content="{Binding ActiveOverlay}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Margin="20" />
    </Border>
  </Panel>
</UserControl>
