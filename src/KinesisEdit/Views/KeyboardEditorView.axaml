<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:KinesisEdit.ViewModels"
             xmlns:views="clr-namespace:KinesisEdit.Views"
             xmlns:controls="clr-namespace:KinesisEdit.Controls"
             xmlns:data="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="620"
             x:Class="KinesisEdit.Views.KeyboardEditorView"
             x:DataType="vm:KeyboardEditorViewModel">
  <!-- The per-device editor of specs/10-apps-and-ui.md: the device and its open profile, the
       layer switch, the section tabs, the keyboard picture the remap workflow runs on, the macro
       panel of the Macros tab, the Lighting and Settings panels, and the feature panels of
       specs/11-feature-dialogs.md rendered as an overlay over all of it. The picture itself is the
       generic KeyboardView; everything device-specific reaches it as data. -->
  <Panel>
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="24,16">

      <!-- Header: what is open, and how much of it has been remapped. -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="{Binding DeviceName}" Classes="deviceHeadline" VerticalAlignment="Center" />

          <StackPanel Orientation="Horizontal"
                      Spacing="10"
                      VerticalAlignment="Center"
                      IsVisible="{Binding ProfileCaption, Converter={x:Static data:StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="·" Classes="meta muted" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ProfileCaption}" Classes="meta muted" VerticalAlignment="Center" />
          </StackPanel>

          <!-- Demo mode never touched the drive and can never save (specs/03-vdrive-and-files.md §3.5).
               Purple, not amber: "nothing is written" is its own state in the design's four-status
               vocabulary, and amber is reserved for advisories. -->
          <TextBlock Text="{x:Static vm:MainWindowViewModel.DemoModeIndicator}"
                     Classes="pill statusDemo"
                     VerticalAlignment="Center"
                     IsVisible="{Binding IsDemoMode}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
          <TextBlock Text="{Binding RemapCounterCaption}" Classes="control" VerticalAlignment="Center" />
          <TextBlock Text="{Binding MacroCounterCaption}" Classes="control" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>

      <!-- Layer switch and the profile-wide actions. The switch is built from the model's layers,
           so it is two pills on a Freestyle Edge RGB and five on an Advantage 360 (issue #41). -->
      <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,16,0,0">
        <ItemsControl Grid.Column="0" ItemsSource="{Binding Layers}" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:KeyboardLayerViewModel">
              <Button Classes="layerTab"
                      Classes.selected="{Binding IsSelected}"
                      Content="{Binding Caption}"
                      Command="{Binding $parent[views:KeyboardEditorView].((vm:KeyboardEditorViewModel)DataContext).SelectLayerCommand}"
                      CommandParameter="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="{x:Static vm:KeyboardEditorViewModel.SavingCaption}"
                     Classes="meta muted"
                     VerticalAlignment="Center"
                     IsVisible="{Binding IsBusy}" />
          <Button Content="Reset Key" Command="{Binding ResetKeyCommand}" />
          <Button Content="Reset Layer" Command="{Binding ResetLayerCommand}" />
          <Button Content="Reset Layout" Command="{Binding ResetLayoutCommand}" />
          <Button Content="Save" Command="{Binding SaveCommand}" Classes="primaryAction" />
        </StackPanel>
      </Grid>

      <!-- Section tabs plus the feature buttons of spec 11. The strip is filtered by what the
           device carries: Lighting is enabled only on the boards whose led file this app edits, and
           a device without lighting or without a settings file does not get that tab at all. Every
           feature button reports its own availability through the command's CanExecute, so there is
           no visibility logic here. -->
      <Grid Grid.Row="2" ColumnDefinitions="Auto,*" Margin="0,16,0,0">
        <ItemsControl Grid.Column="0" ItemsSource="{Binding Tabs}" VerticalAlignment="Bottom">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="2" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:EditorTabViewModel">
              <Button Classes="editorTab"
                      Classes.selected="{Binding IsSelected}"
                      Content="{Binding Caption}"
                      IsEnabled="{Binding IsEnabled}"
                      Command="{Binding $parent[views:KeyboardEditorView].((vm:KeyboardEditorViewModel)DataContext).SelectTabCommand}"
                      CommandParameter="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom">
          <Button Content="Tap and Hold" Command="{Binding TapAndHoldCommand}" Margin="6,0,0,4" />
          <Button Content="Insert Delay" Command="{Binding InsertDelayCommand}" Margin="6,0,0,4" />
          <Button Content="Special Action" Command="{Binding InsertSpecialActionCommand}" Margin="6,0,0,4" />
          <Button Content="Export" Command="{Binding ExportCommand}" Margin="6,0,0,4" />
          <Button Content="Import" Command="{Binding ImportCommand}" Margin="6,0,0,4" />
        </WrapPanel>
      </Grid>

      <Panel Grid.Row="3" Margin="0,12,0,0">
        <TextBlock Text="Loading profile..."
                   Classes="body muted"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsVisible="{Binding IsLoading}" />

        <!-- A save is in flight: the picture stays on screen but nothing may be edited under it. -->
        <Panel IsVisible="{Binding !IsLoading}" IsEnabled="{Binding !IsBusy}">
          <!-- The board serves both tabs: the macro's trigger is the key selected on it, so the
               Macros tab docks its panel beside the picture rather than replacing it. -->
          <Grid ColumnDefinitions="*,Auto"
                IsVisible="{Binding SelectedTab, Converter={StaticResource EnumMatch}, ConverterParameter='Keys,Macros'}">
            <Grid Grid.Column="0" RowDefinitions="Auto,*">
              <!--
                No "Esc cancels" here: while a key is listening the capture service swallows every
                physical key, Escape included, so Escape is assigned like any other key (a keyboard
                must be able to carry an Escape remap). Cancelling is therefore a pointer action.
              -->
              <StackPanel Grid.Row="0"
                          Orientation="Horizontal"
                          Spacing="12"
                          Margin="0,0,0,8"
                          VerticalAlignment="Center"
                          IsVisible="{Binding IsListening}">
                <!-- The banner pulses with the cap it belongs to; the class is bound rather than
                     fixed so the animation only runs while something is actually listening. -->
                <TextBlock Text="Press a key to assign it to the highlighted key."
                           Classes="control statusWarning"
                           Classes.recording="{Binding IsListening}"
                           VerticalAlignment="Center" />
                <Button Content="Cancel"
                        Command="{Binding CancelRemapCommand}"
                        VerticalAlignment="Center" />
              </StackPanel>

              <Border Grid.Row="1"
                      Classes="keyboardBoard"
                      IsVisible="{Binding SelectedLayer, Converter={x:Static data:ObjectConverters.IsNotNull}}">
                <controls:KeyboardView DataContext="{Binding SelectedLayer}"
                                       KeySelectedCommand="{Binding $parent[views:KeyboardEditorView].((vm:KeyboardEditorViewModel)DataContext).SelectKeyCommand}" />
              </Border>
            </Grid>

            <!-- The macro editor of specs/10-apps-and-ui.md and specs/06-macros.md. Every number
                 it shows — slot count, co-trigger cap, speed/repeat ranges, budgets — is the
                 device's, so nothing here is Freestyle Edge RGB specific. -->
            <ContentControl Grid.Column="1"
                            Width="380"
                            Margin="16,0,0,0"
                            Content="{Binding MacroPanel}"
                            IsVisible="{Binding IsMacroPanelVisible}">
              <ContentControl.ContentTemplate>
                <DataTemplate DataType="vm:MacroPanelViewModel">
                  <!-- The panel scrolls, but Assign / Delete / Copy / Paste are pinned: they are
                       what a macro edit ends in and must not need scrolling to reach. -->
                  <Border Classes="card">
                    <Grid RowDefinitions="*,Auto">
                      <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="12" Margin="0,0,8,0">

                          <!-- Macros match on the position's trigger key, not on its remapped
                               action (05 §1.3), so this names that identity. -->
                          <StackPanel Spacing="2">
                            <TextBlock Text="TRIGGER KEY" Classes="sectionLabel" />
                            <!-- The trigger is a key token, so it is rendered the way the file
                                 spells it. -->
                            <TextBlock Text="{Binding TriggerCaption}"
                                       Classes="monoValue"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding HasTriggerKey}" />
                          </StackPanel>

                          <TextBlock Text="{Binding Message}"
                                     Classes="body statusWarning"
                                     TextWrapping="Wrap"
                                     IsVisible="{Binding HasMessage}" />

                          <!-- One radio per macro slot of the trigger key (06 §1); the flat-list
                               families (Advantage360) have none and hide the row. -->
                          <StackPanel Spacing="4" IsVisible="{Binding UsesMacroSlots}">
                            <TextBlock Text="SLOT" Classes="sectionLabel" />
                            <ItemsControl ItemsSource="{Binding Slots}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <StackPanel Orientation="Horizontal" Spacing="6" />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:MacroSlotViewModel">
                                  <Button Classes="layerTab"
                                          Classes.selected="{Binding IsSelected}"
                                          MinWidth="44"
                                          Padding="10,6"
                                          ToolTip.Tip="{Binding Preview}"
                                          Command="{Binding $parent[ItemsControl].((vm:MacroPanelViewModel)DataContext).SelectSlotCommand}"
                                          CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                      <TextBlock Text="{Binding Caption}" />
                                      <TextBlock Text="•" IsVisible="{Binding IsOccupied}" />
                                    </StackPanel>
                                  </Button>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>

                          <StackPanel Spacing="6">
                            <TextBlock Text="KEYSTROKES" Classes="sectionLabel" />

                            <!-- Backspace here is the panel's button: the physical Backspace key is
                                 recordable macro content, never an editing shortcut (06 §2.2). -->
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <Button Content="Record" Command="{Binding RecordCommand}" />
                              <Button Content="Stop" Command="{Binding StopRecordingCommand}" />
                              <Button Content="Backspace" Command="{Binding BackspaceCommand}" />
                              <Button Content="Clear" Command="{Binding ClearCommand}" />
                            </StackPanel>

                            <TextBlock Text="Recording — every key you press is added to the macro."
                                       Classes="control statusWarning"
                                       Classes.recording="{Binding IsRecording}"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding IsRecording}" />

                            <Border Classes="listFrame" MinHeight="56">
                              <ScrollViewer MaxHeight="150" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Steps.Items}">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:MacroStepViewModel">
                                      <Grid ColumnDefinitions="26,*,Auto" Margin="2,1">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Position}"
                                                   Classes="monoValueSmall muted"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Caption}"
                                                   Classes="monoValue"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="2"
                                                Content="✕"
                                                Padding="6,1"
                                                FontSize="{DynamicResource FontSizeBody}"
                                                Command="{Binding $parent[ItemsControl].((vm:MacroPanelViewModel)DataContext).RemoveStepCommand}"
                                                CommandParameter="{Binding}" />
                                      </Grid>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </ScrollViewer>
                            </Border>
                          </StackPanel>

                          <!-- The modifiers the trigger must be pressed with (06 §2.1, §5); the
                               device's cap is held by the panel, which reports a refusal above. -->
                          <StackPanel Spacing="4">
                            <TextBlock Text="CO-TRIGGERS" Classes="sectionLabel" />
                            <ItemsControl ItemsSource="{Binding CoTriggers}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <WrapPanel />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:MacroCoTriggerViewModel">
                                  <Button Classes="layerTab"
                                          Classes.selected="{Binding IsOn}"
                                          Content="{Binding Caption}"
                                          MinWidth="0"
                                          Padding="10,5"
                                          Margin="0,0,6,6"
                                          Command="{Binding $parent[ItemsControl].((vm:MacroPanelViewModel)DataContext).ToggleCoTriggerCommand}"
                                          CommandParameter="{Binding}" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>

                          <!-- Playback speed and multiplay, clamped to the device's ranges (06 §4). -->
                          <Grid ColumnDefinitions="*,*">
                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0" IsVisible="{Binding HasSpeed}">
                              <TextBlock Text="SPEED" Classes="sectionLabel" />
                              <NumericUpDown Value="{Binding Speed, Mode=TwoWay}"
                                             Minimum="{Binding SpeedMinimum}"
                                             Maximum="{Binding SpeedMaximum}"
                                             Increment="1"
                                             FormatString="0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0" IsVisible="{Binding HasRepeat}">
                              <TextBlock Text="REPEAT" Classes="sectionLabel" />
                              <NumericUpDown Value="{Binding Repeat, Mode=TwoWay}"
                                             Minimum="{Binding RepeatMinimum}"
                                             Maximum="{Binding RepeatMaximum}"
                                             Increment="1"
                                             FormatString="0" />
                            </StackPanel>
                          </Grid>

                          <!-- Breaching a budget is reported, never refused (06 §6); Validate() at
                               save time is the backstop. -->
                          <StackPanel Spacing="3">
                            <TextBlock Text="BUDGET" Classes="sectionLabel" />
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                              <TextBlock Grid.Row="0" Grid.Column="0" Text="This macro" Classes="meta muted" />
                              <TextBlock Grid.Row="0" Grid.Column="1"
                                         Text="{Binding Budget.MacroCaption}"
                                         Classes="monoValue"
                                         Classes.statusError="{Binding Budget.IsMacroOverBudget}" />
                              <TextBlock Grid.Row="1" Grid.Column="0" Text="Profile keystrokes" Classes="meta muted" />
                              <TextBlock Grid.Row="1" Grid.Column="1"
                                         Text="{Binding Budget.TotalCaption}"
                                         Classes="monoValue"
                                         Classes.statusError="{Binding Budget.IsTotalOverBudget}" />
                              <TextBlock Grid.Row="2" Grid.Column="0" Text="Macros" Classes="meta muted" />
                              <TextBlock Grid.Row="2" Grid.Column="1"
                                         Text="{Binding Budget.MacroCountCaption}"
                                         Classes="monoValue"
                                         Classes.statusError="{Binding Budget.IsMacroCountOverBudget}" />
                            </Grid>
                            <TextBlock Text="{Binding Budget.OverflowMessage}"
                                       Classes="body statusWarning"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding Budget.IsMacroOverBudget}" />
                          </StackPanel>

                          <!-- Every macro of the profile, each rendered as the file will carry it
                               (06 §3) — the Advantage360's macro repository, shown on every device. -->
                          <StackPanel Spacing="4">
                            <TextBlock Text="MACROS IN THIS PROFILE" Classes="sectionLabel" />
                            <Border Classes="listFrame" MinHeight="40">
                              <ScrollViewer MaxHeight="170" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Macros}">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:MacroListEntryViewModel">
                                      <Button Classes="rowButton"
                                              Classes.selected="{Binding IsSelected}"
                                              Command="{Binding $parent[ItemsControl].((vm:MacroPanelViewModel)DataContext).SelectMacroCommand}"
                                              CommandParameter="{Binding}">
                                        <StackPanel Spacing="1">
                                          <TextBlock Text="{Binding TriggerCaption}" Classes="monoValue" />
                                          <TextBlock Text="{Binding Text}"
                                                     Classes="monoValueSmall muted"
                                                     TextWrapping="Wrap" />
                                        </StackPanel>
                                      </Button>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </ScrollViewer>
                            </Border>
                          </StackPanel>
                        </StackPanel>
                      </ScrollViewer>

                      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,10,0,0">
                        <Button Content="Assign" Command="{Binding AssignCommand}" Classes="primaryAction" />
                        <Button Content="Delete" Command="{Binding DeleteCommand}" />
                        <Button Content="Copy" Command="{Binding CopyCommand}" />
                        <Button Content="Paste" Command="{Binding PasteCommand}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
          </Grid>

          <!-- The lighting editor of specs/07-lighting.md §3/§4; the panels are the mode's, so this
               is one ContentControl and the panel decides what it shows. -->
          <ContentControl Content="{Binding Lighting}"
                          IsVisible="{Binding SelectedTab, Converter={StaticResource EnumMatch}, ConverterParameter=Lighting}" />

          <!-- The keyboard settings of specs/08-settings.md §5; the rows are the device's, so this
               is one ContentControl and the panel decides what it shows. -->
          <ContentControl Content="{Binding Settings}"
                          IsVisible="{Binding SelectedTab, Converter={StaticResource EnumMatch}, ConverterParameter=Settings}" />
        </Panel>
      </Panel>

      <!-- Lines of the loaded file the parser could not apply (specs/04-layout-files.md §5.2). They
           are collapsed by default but never dropped silently. -->
      <Expander Grid.Row="4"
                Margin="0,12,0,0"
                HorizontalAlignment="Stretch"
                IsVisible="{Binding HasInvalidLines}">
        <Expander.Header>
          <TextBlock Text="Some lines of this profile could not be applied"
                     Classes="control statusWarning" />
        </Expander.Header>
        <ItemsControl ItemsSource="{Binding InvalidLineMessages}" MaxHeight="160">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="2" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="x:String">
              <TextBlock Text="{Binding}" TextWrapping="Wrap" Classes="monoValueSmall muted" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Expander>
    </Grid>

    <!-- The feature panels of spec 11, hosted inline rather than as separate windows so keystroke
         capture never has to cross a window boundary. ViewLocator resolves the open overlay's own
         view; the scrim below it swallows every click aimed at the editor underneath. -->
    <Border Classes="overlayScrim"
            Classes.open="{Binding HasActiveOverlay}"
            IsVisible="{Binding HasActiveOverlay}">
      <ContentControl Classes="overlayHost"
                      Classes.open="{Binding HasActiveOverlay}"
                      Content="{Binding ActiveOverlay}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Margin="20" />
    </Border>
  </Panel>
</UserControl>
