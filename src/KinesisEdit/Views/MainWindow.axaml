<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:KinesisEdit.ViewModels"
        xmlns:views="clr-namespace:KinesisEdit.Views"
        xmlns:controls="clr-namespace:KinesisEdit.Controls"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="680"
        x:Class="KinesisEdit.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1000"
        Height="680"
        MinWidth="720"
        MinHeight="480">
  <!-- One window, swapped views: the dashboard, or the editor opened by Configure
       (specs/10-apps-and-ui.md, "Opening a device" / "Home"). Native chrome, OS theme. -->
  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0"
            Background="{DynamicResource SurfaceBarBrush}"
            BorderBrush="{DynamicResource SurfaceLineBrush}"
            BorderThickness="0,0,0,1"
            Height="{DynamicResource HeightToolbar}"
            Padding="16,0">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
          <!-- The app mark (docs/design/handoff.md:115): an 18px accent tile carrying a 700 mono
               "K", then the wordmark at 13/600 sans. It stays type rather than geometry - the
               handoff grants the 700 weight to this one glyph, and a wordmark is not one of the
               three icon families. -->
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Border Classes="logoTile" VerticalAlignment="Center">
              <TextBlock Classes="logoMark"
                         Text="K"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>
            <TextBlock Classes="toolbarDevice" Text="KinesisEdit" VerticalAlignment="Center" />
          </StackPanel>

          <!-- A hairline between the wordmark and the nav, as the mock draws it: the mark names the
               app, the pills say where in it you are, and they are not the same thing. -->
          <Border Width="1"
                  Height="18"
                  VerticalAlignment="Center"
                  Background="{DynamicResource SurfaceLineBrush}" />

          <!-- Home / Settings / Help. Nav pills, whose active face is the raised neutral surface
               rather than the accent: "where you already are" is not one of the accent's two
               meanings. Only Home has a selected state to bind - Settings and Help are their own
               issue (#96) and stay unavailable, so they read as inactive nav rather than as
               something that broke.

               Home is bound to a command that stays runnable on the dashboard, where it does
               nothing. That is not slack: NavPill writes every selected setter as
               `.selected:not(:disabled)`, and a Button takes its enablement from its Command, so a
               Home gated on "there is an editor to leave" would be disabled in exactly the state
               `IsHomeSelected` is true and the active face would be unreachable. -->

          <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <Button Classes="navPill"
                    Content="Home"
                    Command="{Binding HomeCommand}"
                    Classes.selected="{Binding IsHomeSelected}" />
            <Button Classes="navPill" Content="Settings" Command="{Binding SettingsCommand}" />
            <Button Classes="navPill" Content="Help" Command="{Binding HelpCommand}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <!-- "refreshed 0.4s ago" (docs/design/mockups.md §1b). Mono, and this is the one place
               the mono law bends: the string is the app speaking, not a value out of a config file.
               The design sets it in mono anyway, and for a reason that survives the translation -
               a proportional face reflows the whole right-hand end of the bar every time the
               tenths digit changes, five times a second. Hidden outright until a pass has
               completed: there is nothing to age yet, and a zero would claim a scan that never
               happened. -->
          <TextBlock Classes="monoValueSmall muted"
                     Text="{Binding LastRefreshedText}"
                     VerticalAlignment="Center"
                     IsVisible="{Binding HasLastRefreshed}" />

          <!-- 'v-Drive OK' / 'v-Drive Error' / 'Demo Mode', as a chip whose fill cross-fades when
               the detection loop changes its mind; the text inside swaps instantly. -->
          <Border Classes="statusChip"
                  VerticalAlignment="Center"
                  Classes.ok="{Binding StatusIndicatorSeverity, Converter={StaticResource EnumMatch}, ConverterParameter=Ok}"
                  Classes.warning="{Binding StatusIndicatorSeverity, Converter={StaticResource EnumMatch}, ConverterParameter=Warning}"
                  Classes.error="{Binding StatusIndicatorSeverity, Converter={StaticResource EnumMatch}, ConverterParameter=Error}"
                  Classes.demo="{Binding StatusIndicatorSeverity, Converter={StaticResource EnumMatch}, ConverterParameter=Demo}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <!-- The state mark, one per severity and each with its own pen, so exactly one is
                   visible. Demo mode deliberately has none: the state marks describe what the app
                   found on a drive, and demo mode is the absence of one - inventing a mark for it
                   would put a fourth family in a set of three. -->
              <Panel Width="{DynamicResource IconSize}"
                     Height="{DynamicResource IconSize}"
                     VerticalAlignment="Center">
                <controls:Icon Data="{DynamicResource IconConnected}"
                               Stroke="{DynamicResource StatusOkTextBrush}"
                               IsVisible="{Binding StatusIndicatorSeverity, Converter={StaticResource EnumMatch}, ConverterParameter=Ok}" />
                <controls:Icon Data="{DynamicResource IconConnectedCore}"
                               Fill="{DynamicResource StatusOkTextBrush}"
                               IsVisible="{Binding StatusIndicatorSeverity, Converter={StaticResource EnumMatch}, ConverterParameter=Ok}" />
                <controls:Icon Data="{DynamicResource IconWarning}"
                               Stroke="{DynamicResource StatusAdvisoryTextBrush}"
                               IsVisible="{Binding StatusIndicatorSeverity, Converter={StaticResource EnumMatch}, ConverterParameter=Warning}" />
                <controls:Icon Data="{DynamicResource IconCannotAccess}"
                               Stroke="{DynamicResource StatusErrorTextBrush}"
                               IsVisible="{Binding StatusIndicatorSeverity, Converter={StaticResource EnumMatch}, ConverterParameter=Error}" />
              </Panel>

              <TextBlock Classes="pill"
                         Text="{Binding StatusIndicatorText}"
                         VerticalAlignment="Center"
                         Classes.statusOk="{Binding StatusIndicatorSeverity, Converter={StaticResource EnumMatch}, ConverterParameter=Ok}"
                         Classes.statusWarning="{Binding StatusIndicatorSeverity, Converter={StaticResource EnumMatch}, ConverterParameter=Warning}"
                         Classes.statusError="{Binding StatusIndicatorSeverity, Converter={StaticResource EnumMatch}, ConverterParameter=Error}"
                         Classes.statusDemo="{Binding StatusIndicatorSeverity, Converter={StaticResource EnumMatch}, ConverterParameter=Demo}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <Panel Grid.Row="1">
      <ContentControl Content="{Binding CurrentView}" />
      <views:NotificationOverlay x:Name="Notifications" />
    </Panel>
  </Grid>
</Window>
