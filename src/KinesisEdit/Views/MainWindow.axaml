<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:KinesisEdit.ViewModels"
        xmlns:views="clr-namespace:KinesisEdit.Views"
        xmlns:controls="clr-namespace:KinesisEdit.Controls"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="680"
        x:Class="KinesisEdit.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Kinesis Edit"
        Width="1000"
        Height="680"
        MinWidth="720"
        MinHeight="480">
  <!-- One window, swapped views: the dashboard, or the editor opened by Configure
       (specs/10-apps-and-ui.md, "Opening a device" / "Home"). Native chrome, OS theme. -->
  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0"
            Background="{DynamicResource SurfaceBarBrush}"
            BorderBrush="{DynamicResource SurfaceLineBrush}"
            BorderThickness="0,0,0,1"
            Height="{DynamicResource HeightToolbar}"
            Padding="16,0">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
          <!-- The app mark (docs/design/handoff.md:115): an 18px accent tile carrying a 700 mono
               "K", then the wordmark at 13/600 sans. It stays type rather than geometry - the
               handoff grants the 700 weight to this one glyph, and a wordmark is not one of the
               three icon families. -->
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Border Classes="logoTile" VerticalAlignment="Center">
              <TextBlock Classes="logoMark"
                         Text="K"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>
            <TextBlock Classes="toolbarDevice" Text="KinesisEdit" VerticalAlignment="Center" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Content="Home" Command="{Binding HomeCommand}" />
            <Button Content="Settings" Command="{Binding SettingsCommand}" />
            <Button Content="Help" Command="{Binding HelpCommand}" />
          </StackPanel>
        </StackPanel>

        <!-- 'v-Drive OK' / 'v-Drive Error' / 'Demo Mode', as a chip whose fill cross-fades when the
             detection loop changes its mind; the text inside swaps instantly. -->
        <Border Grid.Column="2"
                Classes="statusChip"
                VerticalAlignment="Center"
                Classes.ok="{Binding StatusIndicatorSeverity, Converter={StaticResource EnumMatch}, ConverterParameter=Ok}"
                Classes.warning="{Binding StatusIndicatorSeverity, Converter={StaticResource EnumMatch}, ConverterParameter=Warning}"
                Classes.error="{Binding StatusIndicatorSeverity, Converter={StaticResource EnumMatch}, ConverterParameter=Error}"
                Classes.demo="{Binding StatusIndicatorSeverity, Converter={StaticResource EnumMatch}, ConverterParameter=Demo}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <!-- The state mark, one per severity and each with its own pen, so exactly one is
                 visible. Demo mode deliberately has none: the state marks describe what the app
                 found on a drive, and demo mode is the absence of one - inventing a mark for it
                 would put a fourth family in a set of three. -->
            <Panel Width="{DynamicResource IconSize}"
                   Height="{DynamicResource IconSize}"
                   VerticalAlignment="Center">
              <controls:Icon Data="{DynamicResource IconConnected}"
                             Stroke="{DynamicResource StatusOkTextBrush}"
                             IsVisible="{Binding StatusIndicatorSeverity, Converter={StaticResource EnumMatch}, ConverterParameter=Ok}" />
              <controls:Icon Data="{DynamicResource IconConnectedCore}"
                             Fill="{DynamicResource StatusOkTextBrush}"
                             IsVisible="{Binding StatusIndicatorSeverity, Converter={StaticResource EnumMatch}, ConverterParameter=Ok}" />
              <controls:Icon Data="{DynamicResource IconWarning}"
                             Stroke="{DynamicResource StatusAdvisoryTextBrush}"
                             IsVisible="{Binding StatusIndicatorSeverity, Converter={StaticResource EnumMatch}, ConverterParameter=Warning}" />
              <controls:Icon Data="{DynamicResource IconCannotAccess}"
                             Stroke="{DynamicResource StatusErrorTextBrush}"
                             IsVisible="{Binding StatusIndicatorSeverity, Converter={StaticResource EnumMatch}, ConverterParameter=Error}" />
            </Panel>

            <TextBlock Classes="pill"
                       Text="{Binding StatusIndicatorText}"
                       VerticalAlignment="Center"
                       Classes.statusOk="{Binding StatusIndicatorSeverity, Converter={StaticResource EnumMatch}, ConverterParameter=Ok}"
                       Classes.statusWarning="{Binding StatusIndicatorSeverity, Converter={StaticResource EnumMatch}, ConverterParameter=Warning}"
                       Classes.statusError="{Binding StatusIndicatorSeverity, Converter={StaticResource EnumMatch}, ConverterParameter=Error}"
                       Classes.statusDemo="{Binding StatusIndicatorSeverity, Converter={StaticResource EnumMatch}, ConverterParameter=Demo}" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Panel Grid.Row="1">
      <ContentControl Content="{Binding CurrentView}" />
      <views:NotificationOverlay x:Name="Notifications" />
    </Panel>
  </Grid>
</Window>
