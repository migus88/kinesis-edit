<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:KinesisEdit.ViewModels"
        xmlns:views="clr-namespace:KinesisEdit.Views"
        xmlns:controls="clr-namespace:KinesisEdit.Controls"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="680"
        x:Class="KinesisEdit.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1000"
        Height="680"
        MinWidth="720"
        MinHeight="480">
  <!-- One window, swapped views: the dashboard, or the editor opened by Configure
       (specs/10-apps-and-ui.md, "Opening a device" / "Home"). Native chrome, OS theme. -->
  <Grid RowDefinitions="Auto,*">
    <!-- The app bar, and the shell's half of the "exactly one 46px bar" rule: an editor that draws
         its own toolbar carries the same Home / device / Save / status pill, so this one steps
         aside for it rather than stacking a second bar and a second status chip
         (MainWindowViewModel.IsShellChromeVisible). -->
    <Border Grid.Row="0"
            Background="{DynamicResource SurfaceBarBrush}"
            BorderBrush="{DynamicResource SurfaceLineBrush}"
            BorderThickness="0,0,0,1"
            Height="{DynamicResource HeightToolbar}"
            Padding="16,0"
            IsVisible="{Binding IsShellChromeVisible}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
          <!-- The app mark (docs/design/handoff.md:115): an 18px accent tile carrying a 700 mono
               "K", then the wordmark at 13/600 sans. It stays type rather than geometry - the
               handoff grants the 700 weight to this one glyph, and a wordmark is not one of the
               three icon families. -->
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Border Classes="logoTile" VerticalAlignment="Center">
              <TextBlock Classes="logoMark"
                         Text="K"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>
            <TextBlock Classes="toolbarDevice" Text="KinesisEdit" VerticalAlignment="Center" />
          </StackPanel>

          <!-- A hairline between the wordmark and the nav, as the mock draws it: the mark names the
               app, the pills say where in it you are, and they are not the same thing. -->
          <Border Width="1"
                  Height="18"
                  VerticalAlignment="Center"
                  Background="{DynamicResource SurfaceLineBrush}" />

          <!-- Home / Settings / Help. Nav pills, whose active face is the raised neutral surface
               rather than the accent: "where you already are" is not one of the accent's two
               meanings. All three are real navigations now, so all three bind a selected state -
               `CurrentView` is one of the dashboard, the open editor, Settings or Help, and the
               editor is the only one of the four with no pill of its own.

               Every one of them is bound to a command that stays runnable on its own screen, where
               it does nothing. That is not slack: NavPill writes every selected setter as
               `.selected:not(:disabled)`, and a Button takes its enablement from its Command, so a
               pill gated on "you are somewhere else" would be disabled in exactly the state its
               `Is…Selected` is true and the active face would be unreachable. The no-op lives in
               `MainWindowViewModel.NavigateAsync`, not in the predicate. -->

          <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <controls:AccessibleButton Classes="navPill"
                                       Content="Home"
                                       Command="{Binding HomeCommand}"
                                       Classes.selected="{Binding IsHomeSelected}" />
            <controls:AccessibleButton Classes="navPill"
                                       Content="Settings"
                                       Command="{Binding SettingsCommand}"
                                       Classes.selected="{Binding IsSettingsSelected}" />
            <controls:AccessibleButton Classes="navPill"
                                       Content="Help"
                                       Command="{Binding HelpCommand}"
                                       Classes.selected="{Binding IsHelpSelected}" />
          </StackPanel>
        </StackPanel>

        <!-- The status chip is its own view: the editor's toolbar draws the same one, and a copy
             would drift. It binds to an IShellChrome, which this view model is, so the inherited
             DataContext is already the right one.

             It is the only thing on this end of the bar. The design also drew a mono
             "refreshed 0.4s ago" readout here; scanning is manual now, so there is no loop for it
             to report and nothing in the chrome may imply the app is watching on its own. -->
        <views:StatusChipView Grid.Column="2" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <ContentControl Grid.Row="1" Content="{Binding CurrentView}" />

    <!-- The overlay spans both rows, because a modal message box has to cover the app bar too:
         left in row 1 it would dim the Home / Settings / Help pills and the status chip but leave
         them clickable, and a dialog you can navigate out from behind is not modal. It is the
         topmost child of the grid, so it also draws over the bar rather than under it. -->
    <views:NotificationOverlay x:Name="Notifications" Grid.Row="0" Grid.RowSpan="2" />
  </Grid>
</Window>
