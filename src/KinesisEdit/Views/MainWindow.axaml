<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:KinesisEdit.ViewModels"
        xmlns:views="clr-namespace:KinesisEdit.Views"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="680"
        x:Class="KinesisEdit.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Kinesis Edit"
        Width="1000"
        Height="680"
        MinWidth="720"
        MinHeight="480">
  <!-- One window, swapped views: the dashboard, or the editor opened by Configure
       (specs/10-apps-and-ui.md, "Opening a device" / "Home"). Native chrome, OS theme. -->
  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0"
            Background="{DynamicResource SurfaceBarBrush}"
            BorderBrush="{DynamicResource SurfaceLineBrush}"
            BorderThickness="0,0,0,1"
            Height="{DynamicResource HeightToolbar}"
            Padding="16,0">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="Home" Command="{Binding HomeCommand}" />
          <Button Content="Settings" Command="{Binding SettingsCommand}" />
          <Button Content="Help" Command="{Binding HelpCommand}" />
        </StackPanel>

        <!-- 'v-Drive OK' / 'v-Drive Error' / 'Demo Mode', as a chip whose fill cross-fades when the
             detection loop changes its mind; the text inside swaps instantly. -->
        <Border Grid.Column="2"
                Classes="statusChip"
                VerticalAlignment="Center"
                Classes.ok="{Binding StatusIndicatorSeverity, Converter={StaticResource EnumMatch}, ConverterParameter=Ok}"
                Classes.warning="{Binding StatusIndicatorSeverity, Converter={StaticResource EnumMatch}, ConverterParameter=Warning}"
                Classes.error="{Binding StatusIndicatorSeverity, Converter={StaticResource EnumMatch}, ConverterParameter=Error}"
                Classes.demo="{Binding StatusIndicatorSeverity, Converter={StaticResource EnumMatch}, ConverterParameter=Demo}">
          <TextBlock Classes="pill"
                     Text="{Binding StatusIndicatorText}"
                     Classes.statusOk="{Binding StatusIndicatorSeverity, Converter={StaticResource EnumMatch}, ConverterParameter=Ok}"
                     Classes.statusWarning="{Binding StatusIndicatorSeverity, Converter={StaticResource EnumMatch}, ConverterParameter=Warning}"
                     Classes.statusError="{Binding StatusIndicatorSeverity, Converter={StaticResource EnumMatch}, ConverterParameter=Error}"
                     Classes.statusDemo="{Binding StatusIndicatorSeverity, Converter={StaticResource EnumMatch}, ConverterParameter=Demo}" />
        </Border>
      </Grid>
    </Border>

    <Panel Grid.Row="1">
      <ContentControl Content="{Binding CurrentView}" />
      <views:NotificationOverlay x:Name="Notifications" />
    </Panel>
  </Grid>
</Window>
