<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:KinesisEdit.ViewModels"
        xmlns:views="clr-namespace:KinesisEdit.Views"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="680"
        x:Class="KinesisEdit.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1000"
        Height="680"
        MinWidth="720"
        MinHeight="480">
  <!-- One window, swapped views: the dashboard, or the editor opened by Configure
       (specs/10-apps-and-ui.md, "Opening a device" / "Home"). Native chrome, OS theme. -->
  <Grid RowDefinitions="Auto,*">
    <!-- The app bar, and the shell's half of the "exactly one 46px bar" rule: an editor that draws
         its own toolbar carries the same Home / device / Save / status pill, so this one steps
         aside for it rather than stacking a second bar and a second status chip
         (MainWindowViewModel.IsShellChromeVisible). -->
    <Border Grid.Row="0"
            Background="{DynamicResource SurfaceBarBrush}"
            BorderBrush="{DynamicResource SurfaceLineBrush}"
            BorderThickness="0,0,0,1"
            Height="{DynamicResource HeightToolbar}"
            Padding="16,0"
            IsVisible="{Binding IsShellChromeVisible}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
          <!-- The app mark (docs/design/handoff.md:115): an 18px accent tile carrying a 700 mono
               "K", then the wordmark at 13/600 sans. It stays type rather than geometry - the
               handoff grants the 700 weight to this one glyph, and a wordmark is not one of the
               three icon families. -->
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Border Classes="logoTile" VerticalAlignment="Center">
              <TextBlock Classes="logoMark"
                         Text="K"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>
            <TextBlock Classes="toolbarDevice" Text="KinesisEdit" VerticalAlignment="Center" />
          </StackPanel>

          <!-- A hairline between the wordmark and the nav, as the mock draws it: the mark names the
               app, the pills say where in it you are, and they are not the same thing. -->
          <Border Width="1"
                  Height="18"
                  VerticalAlignment="Center"
                  Background="{DynamicResource SurfaceLineBrush}" />

          <!-- Home / Settings / Help. Nav pills, whose active face is the raised neutral surface
               rather than the accent: "where you already are" is not one of the accent's two
               meanings. Only Home has a selected state to bind - Settings and Help are their own
               issue (#96) and stay unavailable, so they read as inactive nav rather than as
               something that broke.

               Home is bound to a command that stays runnable on the dashboard, where it does
               nothing. That is not slack: NavPill writes every selected setter as
               `.selected:not(:disabled)`, and a Button takes its enablement from its Command, so a
               Home gated on "there is an editor to leave" would be disabled in exactly the state
               `IsHomeSelected` is true and the active face would be unreachable. -->

          <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <Button Classes="navPill"
                    Content="Home"
                    Command="{Binding HomeCommand}"
                    Classes.selected="{Binding IsHomeSelected}" />
            <Button Classes="navPill" Content="Settings" Command="{Binding SettingsCommand}" />
            <Button Classes="navPill" Content="Help" Command="{Binding HelpCommand}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <!-- "refreshed 0.4s ago" (docs/design/mockups.md §1b). Mono, and this is the one place
               the mono law bends: the string is the app speaking, not a value out of a config file.
               The design sets it in mono anyway, and for a reason that survives the translation -
               a proportional face reflows the whole right-hand end of the bar every time the
               tenths digit changes, five times a second. Hidden outright until a pass has
               completed: there is nothing to age yet, and a zero would claim a scan that never
               happened. -->
          <TextBlock Classes="monoValueSmall muted"
                     Text="{Binding LastRefreshedText}"
                     VerticalAlignment="Center"
                     IsVisible="{Binding HasLastRefreshed}" />

          <!-- The status chip is its own view: the editor's toolbar draws the same one, and a
               copy would drift. It binds to an IShellChrome, which this view model is, so the
               inherited DataContext is already the right one. -->
          <views:StatusChipView VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <ContentControl Grid.Row="1" Content="{Binding CurrentView}" />

    <!-- The overlay spans both rows, because a modal message box has to cover the app bar too:
         left in row 1 it would dim the Home / Settings / Help pills and the status chip but leave
         them clickable, and a dialog you can navigate out from behind is not modal. It is the
         topmost child of the grid, so it also draws over the bar rather than under it. -->
    <views:NotificationOverlay x:Name="Notifications" Grid.Row="0" Grid.RowSpan="2" />
  </Grid>
</Window>
