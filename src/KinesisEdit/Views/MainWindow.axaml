<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:KinesisEdit.ViewModels"
        xmlns:views="clr-namespace:KinesisEdit.Views"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="680"
        x:Class="KinesisEdit.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Kinesis Edit"
        Width="1000"
        Height="680"
        MinWidth="720"
        MinHeight="480">
  <!-- One window, swapped views: the dashboard, or the editor opened by Configure
       (specs/10-apps-and-ui.md, "Opening a device" / "Home"). Native chrome, OS theme. -->
  <Grid RowDefinitions="Auto,*">
    <!-- The app bar, and the shell's half of the "exactly one 46px bar" rule: an editor that draws
         its own toolbar carries the same Home / device / Save / status pill, so this one steps
         aside for it rather than stacking a second bar and a second status chip
         (MainWindowViewModel.IsShellChromeVisible). -->
    <Border Grid.Row="0"
            Background="{DynamicResource SurfaceBarBrush}"
            BorderBrush="{DynamicResource SurfaceLineBrush}"
            BorderThickness="0,0,0,1"
            Height="{DynamicResource HeightToolbar}"
            Padding="16,0"
            IsVisible="{Binding IsShellChromeVisible}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
          <!-- The app mark (docs/design/handoff.md:115): an 18px accent tile carrying a 700 mono
               "K", then the wordmark at 13/600 sans. It stays type rather than geometry - the
               handoff grants the 700 weight to this one glyph, and a wordmark is not one of the
               three icon families. -->
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Border Classes="logoTile" VerticalAlignment="Center">
              <TextBlock Classes="logoMark"
                         Text="K"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>
            <TextBlock Classes="toolbarDevice" Text="KinesisEdit" VerticalAlignment="Center" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Content="Home" Command="{Binding HomeCommand}" />
            <Button Content="Settings" Command="{Binding SettingsCommand}" />
            <Button Content="Help" Command="{Binding HelpCommand}" />
          </StackPanel>
        </StackPanel>

        <!-- The status chip is its own view: the editor's toolbar draws the same one, and a copy
             would drift. It binds to an IShellChrome, which this view model is, so the inherited
             DataContext is already the right one. -->
        <views:StatusChipView Grid.Column="2" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Panel Grid.Row="1">
      <ContentControl Content="{Binding CurrentView}" />
      <views:NotificationOverlay x:Name="Notifications" />
    </Panel>
  </Grid>
</Window>
