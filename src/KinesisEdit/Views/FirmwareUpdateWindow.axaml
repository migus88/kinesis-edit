<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:KinesisEdit.ViewModels"
        mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="230"
        x:Class="KinesisEdit.Views.FirmwareUpdateWindow"
        x:DataType="vm:FirmwareUpdateViewModel"
        Title="{Binding Title}"
        Width="460"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <!-- The "Check for Updates" dialog of specs/09-firmware.md §3: one labeled row per checked
       component, each with its own state caption. The row list itself is what shrinks the window
       on the Advantage 360 (no lighting row), so the height is sized to content rather than fixed. -->
  <StackPanel Margin="20" Spacing="12">
    <ItemsControl ItemsSource="{Binding Rows}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="8" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="vm:FirmwareUpdateRowViewModel">
          <Grid ColumnDefinitions="150,*">
            <TextBlock Grid.Column="0"
                       Text="{Binding Label}"
                       VerticalAlignment="Center"
                       TextAlignment="Right"
                       Margin="0,0,12,0" />

            <!-- Only 'Update Now' is clickable (§3 step 5): the accent color and the hand cursor
                 come from the state, every other state renders as a disabled button. -->
            <Button Grid.Column="1"
                    Content="{Binding ButtonCaption}"
                    Command="{Binding OpenCommand}"
                    IsEnabled="{Binding IsActionable}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Classes.updateAvailable="{Binding State, Converter={StaticResource EnumMatch}, ConverterParameter=UpdateAvailable}" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Button Content="{x:Static vm:FirmwareUpdateViewModel.CloseCaption}"
            Click="OnCloseClick"
            HorizontalAlignment="Right"
            MinWidth="88" />
  </StackPanel>
</Window>
