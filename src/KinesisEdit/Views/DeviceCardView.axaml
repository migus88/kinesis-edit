<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:KinesisEdit.ViewModels"
             mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="200"
             x:Class="KinesisEdit.Views.DeviceCardView"
             x:DataType="vm:DeviceCardViewModel">
  <Border Classes="card deviceCard" Width="320">
    <StackPanel Spacing="12">
      <TextBlock Text="{Binding DisplayName}" Classes="cardTitle" TextWrapping="Wrap" />

      <!-- 'Connected' / 'Not Detected' / 'Cannot Access' (specs/10-apps-and-ui.md), as a chip whose
           fill cross-fades when the detection loop changes its mind. -->
      <Border Classes="statusChip"
              HorizontalAlignment="Left"
              Classes.ok="{Binding StatusSeverity, Converter={StaticResource EnumMatch}, ConverterParameter=Ok}"
              Classes.warning="{Binding StatusSeverity, Converter={StaticResource EnumMatch}, ConverterParameter=Warning}"
              Classes.error="{Binding StatusSeverity, Converter={StaticResource EnumMatch}, ConverterParameter=Error}">
        <TextBlock Text="{Binding StatusText}"
                   Classes="pill"
                   Classes.statusOk="{Binding StatusSeverity, Converter={StaticResource EnumMatch}, ConverterParameter=Ok}"
                   Classes.statusWarning="{Binding StatusSeverity, Converter={StaticResource EnumMatch}, ConverterParameter=Warning}"
                   Classes.statusError="{Binding StatusSeverity, Converter={StaticResource EnumMatch}, ConverterParameter=Error}" />
      </Border>

      <Button Content="{Binding PrimaryActionCaption}"
              Command="{Binding ConfigureCommand}"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center" />

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="{Binding SecondaryActionCaption}" Command="{Binding SecondaryActionCommand}" />
        <Button Content="{x:Static vm:DeviceCardViewModel.EjectActionCaption}"
                Command="{Binding EjectCommand}"
                IsVisible="{Binding CanEject}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
