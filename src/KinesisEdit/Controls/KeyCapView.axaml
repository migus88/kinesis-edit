<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:KinesisEdit.ViewModels"
             xmlns:controls="clr-namespace:KinesisEdit.Controls"
             mc:Ignorable="d" d:DesignWidth="44" d:DesignHeight="44"
             x:Class="KinesisEdit.Controls.KeyCapView"
             x:DataType="vm:KeyboardKeyViewModel"
             ClipToBounds="False">
  <!-- One key cap. The cap is a Button so it is focusable and clickable without code-behind; all
       of its chrome comes from the KeyCapButton control theme in Themes/ControlThemes/Keycap.axaml,
       which owns the template and the whole state matrix (selected / listening / modified /
       locked). The click goes to the editor through the containing KeyboardView, so nothing here
       knows what a remap is (specs/10-apps-and-ui.md, "Remap workflow").

       ClipToBounds is off on the way out as well as in: a focused cap casts a 3px halo past its own
       bounds into a grid whose caps are 4px apart, and a clip anywhere along the chain erases it. -->
  <Button Classes="keyCap"
          ClipToBounds="False"
          Classes.selected="{Binding IsSelected}"
          Classes.listening="{Binding IsListening}"
          Classes.modified="{Binding IsModified}"
          Classes.locked="{Binding !CanEdit}"
          Command="{Binding $parent[controls:KeyboardView].KeySelectedCommand}"
          CommandParameter="{Binding}"
          ToolTip.Tip="{Binding Caption}">
    <Grid RowDefinitions="*,Auto">
      <!-- A '\n' in the caption is a two-line cap (specs/05-key-model.md §1.1); wrapping is on so
           long captions on a 1U cap break instead of being clipped mid-word. -->
      <TextBlock Grid.Row="0"
                 Classes="keyCapText"
                 Classes.modified="{Binding IsModified}"
                 Classes.locked="{Binding !CanEdit}"
                 Text="{Binding Caption}"
                 TextWrapping="Wrap"
                 TextAlignment="Center"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" />

      <!-- The key's LED colour (ledN.txt), shown as a strip rather than as the cap background so
           the cap's own state stays readable next to it.

           The strip is always drawn, and it is hatched underneath: "off is hatched, never black"
           (docs/design/handoff.md, "Focus, selection, key badges"; and again in the lighting screen
           as "off keys are hatched, not black"), because black is a colour a key can legitimately
           be lit. So the hatch is the strip's own background and the colour, when there is one,
           covers it — an unlit key shows the hatch rather than vanishing or going dark, and the cap
           does not change height when the lighting model arrives.

           The view model cannot yet tell "this key's LED is off" from "no lighting data reached
           this board": KeyColorOverlay.Build drops black entries and yields nothing at all for a
           device without per-key RGB, and both arrive here as HasColorOverlay == false. Every board
           the app can currently draw has per-key RGB, so the two coincide; a device whose LEDs are
           not per-key needs the distinction made in the view model rather than guessed at here. -->
      <Border Grid.Row="1"
              Height="3"
              CornerRadius="{DynamicResource RadiusChip}"
              Margin="1,2,1,0"
              ClipToBounds="True"
              Background="{DynamicResource HatchBrush}">
        <Border CornerRadius="{DynamicResource RadiusChip}"
                IsVisible="{Binding HasColorOverlay}"
                Background="{Binding ColorOverlayHex, Converter={StaticResource HexColorToBrush}}" />
      </Border>
    </Grid>
  </Button>
</UserControl>
